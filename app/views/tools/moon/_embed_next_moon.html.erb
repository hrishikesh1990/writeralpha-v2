<%# locals: gemstone/entry (hub or guide pages; entry may be nil) or article. Never raises on missing data. %>
<%
  is_stone_page = local_assigns.key?(:gemstone)
  entry = local_assigns[:entry]
  show = !is_stone_page || entry
%>
<% if show %>
<%
  now = Time.current.utc
  full = MoonCalendar.next_phase(:full_moon, now)
  t = full.minute
  name, = MoonCalendar.full_moon_name(full)
  stone = entry
  water = stone&.safety("water")
  sun = stone&.safety("sun")
  moon_water =
    if stone.nil? then nil
    elsif water == "safe" && stone.toxicity != "caution" && stone.elixir == "direct"
      [:good, "Moon water OK", "#{stone.name} is non-porous and insoluble, so it can sit in the bowl."]
    elsif water == "safe" && stone.toxicity != "caution" && stone.elixir == "indirect"
      [:warn, "Indirect only", "Water-safe, but keep #{stone.name} in a sealed glass inside the moon water rather than loose in it."]
    elsif water == "safe"
      [:bad, "No moon water", stone.toxicity_reason.presence || "Keep #{stone.name} out of water you might use or drink."]
    elsif water == "brief"
      [:bad, "No moon water", "The water verdict is a quick rinse only, never a soak, so keep #{stone.name} beside the bowl, not in it. #{stone.safety_reason('water')}".strip]
    elsif water == "avoid"
      [:bad, "No moon water", stone.safety_reason("water").presence || "Water damages this stone."]
    else
      [:warn, "Keep dry", "There is no water verdict on file for #{stone.name}, so keep it dry to be safe."]
    end
%>
<aside class="not-prose my-8 rounded-[18px] border border-violet/10 bg-white/85 px-[22px] py-5 shadow-card" data-controller="moon-localtime" data-screen-label="Next full moon">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Next full moon</div>
      <div class="mt-2 text-[16px] font-semibold leading-[1.3] text-ink">
        <time datetime="<%= t.iso8601 %>" data-moon-localtime-target="time"><%= t.strftime("%a, %-d %b %Y, %-H:%M") %> UTC</time>
      </div>
      <div class="mt-1 text-[12.5px] font-light text-muted"><%= name %> · <%= full.glyph %> Moon in <%= full.sign_label %> (<%= full.element %>) · <%= MoonCalendar::Format.countdown(full.time, now) %></div>
    </div>
    <div class="flex size-[56px] flex-none items-center justify-center rounded-full bg-ink/97" aria-hidden="true">
      <%= render "tools/moon/moon_disc", angle: 180, size: 44, uid: "emb#{rand(100_000)}", label: "Full moon" %>
    </div>
  </div>
  <p class="mt-3 text-[13px] font-light leading-[1.7] text-ui">
    <% if stone %>
      Set <%= stone.name %> on a windowsill from dusk, wipe it clean in the morning, and you have cleansed and charged it.
    <% else %>
      A simple ritual: wipe your stones clean, set them on a windowsill from dusk to dawn, and collect them before sunrise.
    <% end %>
    Crystal tradition says the night before or after works as well as the exact minute.
  </p>
  <% if stone %>
    <ul class="mt-3 space-y-[10px]">
      <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] font-light leading-[1.6] text-ui">
        <%= verdict_badge(nil, label: "Moonlight OK", tone: :good) %>
        <span>Moonlight is safe for <%= stone.name %>, and for every stone.<%= " It fades or suffers in strong sun, so moonlight is the better way to charge it." if %w[limit avoid].include?(sun) %></span>
      </li>
      <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] font-light leading-[1.6] text-ui">
        <%= verdict_badge(nil, label: moon_water[1], tone: moon_water[0]) %>
        <span><%= moon_water[2] %></span>
      </li>
    </ul>
  <% else %>
    <p class="mt-3 text-[12.5px] font-light leading-[1.6] text-ui">Moonlight is safe for every stone. Moon water is only for stones whose water verdict is safe, so keep soft, porous or iron-bearing stones dry.</p>
  <% end %>
  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px] font-medium">
    <a href="<%= tools_moon_path %>">Full moon calendar and your time zone →</a>
    <a href="<%= tools_moon_path(anchor: "subscribe") %>">Subscribe in your calendar</a>
  </div>
</aside>
<% end %>
