<%# locals: gemstone, entry (AtlasEntry or nil), guide %>
<% if local_assigns[:entry].present? && entry.respond_to?(:safety) && entry.safety("water").present? %>
  <% row = CrystalSafety.row(entry) %>
  <% focus = guide.to_s == "sleeping-with" ? "sleep" : "water" %>
  <% lead_keys = focus == "sleep" ? %w[sleep] : %w[water salt] %>
  <% labels = { "water" => "Water", "salt" => "Salt water", "sun" => "Sun", "sleep" => "Sleeping with it", "wear" => "Wearing it" } %>
  <% rest = %w[water salt sun sleep wear] - lead_keys %>
  <section class="mt-10 max-w-[760px] rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft" aria-labelledby="safety-embed-title" data-screen-label="Safety card">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Crystal Safety Checker · <%= entry.name %></div>
    <h2 id="safety-embed-title" class="mt-2 text-[18px] font-semibold leading-[1.3] text-ink">
      <%= focus == "sleep" ? "Is it safe to sleep with #{entry.name}?" : "Can #{entry.name} go in water?" %>
    </h2>

    <div class="mt-4 flex flex-col gap-3">
      <% lead_keys.each do |key| %>
        <div class="rounded-[14px] border border-violet/10 bg-white/80 px-4 py-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-[13px] font-medium text-ink"><%= labels[key] %></span>
            <%= row.verdict(key) ? verdict_badge(row.verdict(key)) : verdict_badge(nil, label: "Not rated", tone: :info) %>
          </div>
          <p class="mt-2 text-[13px] font-light leading-[1.7] text-ui"><%= row.reason(key).presence || "No verdict is recorded for this stone yet." %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-faint">The rest at a glance</div>
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
      <% rest.each do |key| %>
        <li class="flex items-center gap-[6px] text-[12px] text-muted"><%= labels[key] %> <%= row.verdict(key) ? verdict_badge(row.verdict(key)) : verdict_badge(nil, label: "Not rated", tone: :info) %></li>
      <% end %>
      <li class="flex items-center gap-[6px] text-[12px] text-muted">Toxicity <%= verdict_badge(row.toxicity, label: { "none" => "Non-toxic", "low" => "Low risk", "caution" => "Toxic: take care" }[row.toxicity], tone: (:bad if row.toxicity == "caution")) %></li>
    </ul>
    <% if row.toxicity == "caution" && row.toxicity_reason.present? %>
      <p class="mt-3 rounded-[12px] border border-rose-600/20 bg-rose-500/6 px-3 py-2 text-[12.5px] font-light leading-[1.65] text-ui"><%= row.toxicity_reason %></p>
    <% end %>

    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-0 text-[12.5px] font-medium [&_a]:inline-flex [&_a]:min-h-8 [&_a]:items-center">
      <a href="<%= tools_safety_path(stone: entry.slug) %>">Full <%= entry.name %> safety card →</a>
      <a href="<%= tools_safety_path %>">Check other stones →</a>
    </div>
  </section>
<% end %>
