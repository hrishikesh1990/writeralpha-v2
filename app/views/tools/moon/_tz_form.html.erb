<%# locals: action (path), tone (:dark | :light), frame (turbo frame id, optional) %>
<% dark = local_assigns[:tone] == :dark %>
<form action="<%= action %>" method="get" class="flex flex-wrap items-center gap-x-3 gap-y-2" data-moon-timezone-target="form"<%= %( data-turbo-frame="#{local_assigns[:frame]}").html_safe if local_assigns[:frame] %>>
  <label for="moon-tz" class="text-[12px] <%= dark ? "text-white/70" : "text-muted" %>">Times shown in</label>
  <select id="moon-tz" name="tz" data-moon-timezone-target="select" data-action="change->moon-timezone#change"
          class="w-full max-w-[300px] rounded-full border px-4 py-[7px] text-[12.5px] <%= dark ? "border-white/20 bg-white/10 text-white" : "border-violet/20 bg-white text-ink" %>">
    <% zone_options.each do |label, id| %>
      <option value="<%= id %>" <%= "selected" if id == fmt.zone_id(zone) %> class="text-ink"><%= label %></option>
    <% end %>
  </select>
  <button type="submit" class="rounded-full px-4 py-[7px] text-[12px] font-medium <%= dark ? "bg-white/15 text-white hover:bg-white/25" : "bg-violet/10 text-violet-deep hover:bg-violet/16" %>">Show</button>
  <button type="button" hidden data-moon-timezone-target="detected" data-action="moon-timezone#useDetected"
          class="rounded-full border px-4 py-[7px] text-[12px] <%= dark ? "border-white/25 text-white/85 hover:text-white" : "border-violet/20 text-violet-deep" %>"></button>
</form>
