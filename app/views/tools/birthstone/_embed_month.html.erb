<%# Embed for /gemstones/birth-month/<month>. locals: filter_type, value (lower-case month name). Renders nothing for an unknown value. %>
<% month = value.to_s.downcase %>
<% if BirthstoneCalculator::MONTHS.include?(month) %>
  <% calc = BirthstoneCalculator.new(catalog: AtlasEntry.all) %>
  <% bm = calc.month_stones(month) %>
  <% name = month.capitalize %>
  <% modern_keys = bm.modern.map(&:key) %>
  <% trad_keys = bm.traditional.map(&:key) %>
  <% rows = (bm.modern + bm.traditional).uniq(&:key).sort_by { |s| [(modern_keys.include?(s.key) && trad_keys.include?(s.key)) ? 0 : 1, modern_keys.index(s.key) || 99] } %>
  <% names = ->(list) { list.map { |s| s.name.downcase }.to_sentence(last_word_connector: " and ", two_words_connector: " and ") } %>
  <% same = modern_keys.sort == trad_keys.sort %>
  <% idx = BirthstoneCalculator::MONTHS.index(month) %>
  <% prev_m = BirthstoneCalculator::MONTHS[(idx - 1) % 12] %>
  <% next_m = BirthstoneCalculator::MONTHS[(idx + 1) % 12] %>
  <section class="px-5 pb-8 pt-2 sm:px-11" data-screen-label="<%= name %> birthstones" aria-labelledby="bs-month-h">
    <div class="grid items-start gap-6 rounded-[22px] border border-violet/10 bg-white/85 p-5 shadow-card sm:p-7 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Birthstones</div>
        <h2 id="bs-month-h" class="mt-2 text-[24px] font-semibold leading-[1.2] text-ink"><%= name %> birthstones</h2>
        <p class="mt-3 max-w-[640px] text-[14px] font-light leading-[1.8] text-ui">
          <% if bm.modern.size == 1 %>
            The modern <%= name %> birthstone is <%= names.(bm.modern) %>.
          <% else %>
            The modern list gives <%= %w[zero one two three four][bm.modern.size] %> <%= name %> birthstones: <%= names.(bm.modern) %>.
          <% end %>
          <% if same %>
            The traditional list, from before 1912, names <%= bm.traditional.size == 1 ? "the same stone" : "the same stones" %>.
          <% else %>
            The traditional list, from before 1912, names <%= names.(bm.traditional) %>.
          <% end %>
          <% if bm.modern.size > 1 %>Several stones are listed because some gems are rare and costly while others are more popular, so you can choose whichever suits your taste and budget.<% end %>
        </p>

        <ul class="mt-6">
          <% rows.each do |ref| %>
            <% badges = [] %>
            <% badges << ["Modern", "bg-violet/10 text-violet-deep"] if modern_keys.include?(ref.key) %>
            <% badges << ["Traditional", "bg-sky/8 text-sky-text"] if trad_keys.include?(ref.key) %>
            <%= render "tools/birthstone/stone_row", ref: ref, lang: "en", badges: badges %>
          <% end %>
        </ul>
        <% if bm.also.any? %>
          <p class="mt-5 rounded-[14px] bg-violet/5 px-4 py-3 text-[12.5px] font-light leading-[1.7] text-ui">
            <span class="font-medium text-ink">Also sold as a <%= name %> birthstone:</span>
            <%= safe_join(bm.also.map { |s| render("tools/birthstone/name", ref: s, lang: "en") }, ", ") %>.
            <%= bm.also.first.summary %>
          </p>
        <% end %>
        <p class="mt-5 text-[11.5px] font-light leading-[1.6] text-muted">Modern: American Gem Trade Association and Jewelers of America. Traditional: the pre-1912 list. Lists differ slightly between trade bodies. Meanings attached to birthstones are tradition, not science.</p>
        <nav class="mt-3 flex flex-wrap gap-x-5 text-[12.5px] font-medium" aria-label="Other months">
          <a href="<%= gemstones_by_birth_month_path(value: prev_m) %>" class="inline-flex min-h-[32px] items-center">← <%= prev_m.capitalize %> birthstones</a>
          <a href="<%= gemstones_by_birth_month_path(value: next_m) %>" class="inline-flex min-h-[32px] items-center"><%= next_m.capitalize %> birthstones →</a>
        </nav>
      </div>

      <aside class="flex flex-col gap-4">
        <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[20px] py-4">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Zodiac signs in <%= name %></div>
          <ul class="flex flex-col gap-[10px]">
            <% bm.signs.each do |sign| %>
              <li>
                <a href="<%= gemstones_by_zodiac_path(value: sign) %>" class="flex items-center gap-3 text-ui hover:text-violet-deep">
                  <span class="flex size-[34px] flex-none items-center justify-center rounded-[10px] bg-violet/8 text-[17px] text-violet-deep" aria-hidden="true"><%= text_glyph(Atlas::Astro::SIGN_GLYPHS[sign]) %></span>
                  <span><span class="block text-[13.5px] font-medium text-ink"><%= sign.capitalize %></span><span class="block text-[11.5px] font-light text-muted"><%= Atlas::Astro::SIGN_DATES[sign] %></span></span>
                </a>
              </li>
            <% end %>
          </ul>
          <p class="mt-3 text-[11.5px] font-light leading-[1.6] text-muted">Western Sun signs by usual dates. Stones tradition links to each sign are on its zodiac page.</p>
        </div>

        <div class="relative overflow-hidden rounded-[18px] bg-ink/97 px-[22px] py-5">
          <div class="glow-violet -right-[30px] -top-10 h-[140px] w-[180px] blur-[16px]" aria-hidden="true"></div>
          <div class="relative mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Birthstone calculator</div>
          <p class="relative text-[14px] font-light leading-[1.65] text-white/90">Born in <%= name %>? See your zodiac stones, your Vedic ratna by rashi and your weekday stone, in English, Hindi and Bengali.</p>
          <%= form_with url: tools_birthstone_path(anchor: "results"), method: :get, class: "relative mt-4 flex flex-col gap-3", data: { turbo_frame: "_top" } do %>
            <label for="bs-month-dob" class="text-[12px] font-medium text-lavender">Date of birth</label>
            <%= date_field_tag :dob, "", id: "bs-month-dob", required: true, min: "1900-01-01", max: "2100-12-31", autocomplete: "bday",
                               class: "w-full rounded-[14px] border border-white/15 bg-white px-4 py-3 text-[14px] text-ink focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/40" %>
            <button type="submit" class="min-h-[44px] rounded-full bg-white px-5 text-[13px] font-medium text-ink card-transition hover:bg-lavender hover:text-ink">Show my stones</button>
          <% end %>
          <a href="<%= tools_birthstone_path %>" class="relative mt-2 inline-flex min-h-[32px] items-center text-[12.5px] font-medium text-lavender hover:text-white">Open the full calculator →</a>
        </div>
      </aside>
    </div>
  </section>
<% end %>
