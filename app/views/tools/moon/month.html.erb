<% noindex_when_params!(:tz) %>
<% tool_jsonld(name: "Moon phases #{@month_label}", description: @meta[:description], path: request.path) %>
<%
  faq = []
  utc = fmt.utc_zone
  @guides.each do |f, g|
    when_utc = "#{fmt.date(f.minute, utc)} at #{fmt.clock(f.minute, utc)} UTC"
    when_local = fmt.zone_id(zone) == "UTC" ? "" : ", which is #{fmt.date(f.minute, zone)} at #{fmt.clock(f.minute, zone)} #{fmt.abbr(f.minute, zone)} in #{fmt.zone_id(zone).tr('_', ' ')}"
    on = @guides.size > 1 ? " on #{fmt.day_month(f.minute, utc)}" : ""
    faq << ["When is the #{g.title_name} in #{@month_label}#{on}?", "#{when_utc}#{when_local}."]
    faq << ["Which sign is the Moon in at the #{g.name}#{on}?", "The Moon is in #{f.sign_label}, #{fmt.indefinite(f.element)} sign, in the tropical (Western) zodiac. At a full moon the Moon sits opposite the Sun, which is in #{Atlas::Astro.sign_for_longitude(f.sun_longitude).capitalize}."]
  end
  if @new
    faq << ["When is the new moon in #{@month_label}?", "#{fmt.date(@new.minute, utc)} at #{fmt.clock(@new.minute, utc)} UTC, with the Moon in #{@new.sign_label}."]
  end
  faq << ["Can I put crystals in moon water?", "Only stones whose water verdict is safe, and keep soft, porous, glued, iron-bearing or toxic stones dry. Moonlight alone, with no water, is safe for every stone."]
  content_for(:jsonld, tag.script({ "@context" => "https://schema.org", "@type" => "FAQPage",
    "mainEntity" => faq.map { |q, a| { "@type" => "Question", "name" => q, "acceptedAnswer" => { "@type" => "Answer", "text" => a } } } }.to_json.html_safe, type: "application/ld+json"))
%>
<div data-controller="moon-timezone" data-moon-timezone-current-value="<%= tz_param %>" data-moon-timezone-explicit-value="<%= params[:tz].present? %>">
<%= tool_header(title: (@full ? "Full Moon #{@month_label}" : "Moon Phases #{@month_label}"), eyebrow: "Moon Cleansing Calendar",
                lede: (@full ? "The #{@guides.first&.last&.name} of #{@month_label}: exact date and time, the Moon's sign, what to charge and what to keep out of moon water." : "All four moon phases for #{@month_label} with the Moon's sign and what to do with your crystals."),
                crumbs: [["Home", root_path], ["Tools", tools_path], ["Moon Calendar", tools_moon_path(tz: tz_param)], [@month_label, nil]]) %>

<% if @full %>
<% f = @full; ft = f.minute; g = @guides.first.last %>
<section class="px-5 pb-2 pt-4 sm:px-11" data-screen-label="Full moon">
  <div class="relative overflow-hidden rounded-[26px] bg-ink/97 px-6 py-8 sm:px-10 sm:py-10">
    <div class="pointer-events-none absolute -right-16 -top-16 h-[320px] w-[420px] blur-[22px]" style="background:radial-gradient(ellipse,rgba(124,58,237,0.5),transparent 70%)" aria-hidden="true"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_200px]">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-lavender"><%= g.name %> · <%= @month_label %></div>
        <h2 class="mt-3 text-[26px] font-semibold leading-[1.2] text-white sm:text-[32px]">
          <time datetime="<%= ft.iso8601 %>"><%= fmt.date(ft, zone) %>, <%= fmt.clock(ft, zone) %></time>
          <span class="font-light text-white/70">in <%= fmt.zone_label(ft, zone) %></span>
        </h2>
        <p class="mt-4 max-w-[600px] text-[14px] font-light leading-[1.7] text-white/80">
          <%= @full_moons.size > 1 ? "The first full moon of #{@month_label}" : "The #{@month_label} full moon" %> is the <strong class="font-medium text-white"><%= g.name %></strong><%= " (#{MoonCalendar.full_moon_name(f)[1]})" if MoonCalendar.full_moon_name(f)[1] %>. The Moon is in
          <strong class="font-medium text-white"><%= f.glyph %> <%= f.sign_label %></strong>, <%= fmt.indefinite(f.element) %> sign, at about <%= f.degree %>° <%= f.sign_label %> in the tropical zodiac.
          <% if @full_moons.size > 1 %>A second full moon follows on <%= fmt.day_month(@full_moons.last.minute, zone) %>, with the Moon in <%= @full_moons.last.sign_label %>. It is a Blue Moon: the second full moon in one calendar month.<% end %>
        </p>
        <% if @year == @now.year && @mon == @now.month || (f.time > @now && f.time - @now < 62 * 86_400) %>
          <p class="mt-3 text-[16px] font-light text-lavender"><%= fmt.countdown(f.time, @now) %></p>
        <% end %>
        <div class="mt-6"><%= render "tools/moon/tz_form", action: request.path, tone: :dark %></div>
      </div>
      <div class="flex flex-col items-center"><%= render "tools/moon/moon_disc", angle: 180, size: 170, uid: "mhero", label: "Full moon" %></div>
    </div>
  </div>
</section>
<% else %>
<section class="px-5 pb-2 pt-4 sm:px-11" data-screen-label="No full moon">
  <% pf = MoonCalendar.previous_phase(:full_moon, @phases.first&.time || Time.utc(@year, @mon, 1)); nf = MoonCalendar.next_phase(:full_moon, @phases.last&.time || Time.utc(@year, @mon, 28)) %>
  <div class="relative overflow-hidden rounded-[26px] bg-ink/97 px-6 py-8 sm:px-10">
    <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-lavender">No full moon this month</div>
    <p class="mt-3 max-w-[640px] text-[15px] font-light leading-[1.7] text-white/85">No full moon falls in <%= @month_label %> by <%= fmt.zone_id(zone).tr("_", " ") %> time. The nearest are <strong class="font-medium text-white"><%= fmt.date(pf.minute, zone) %></strong> and <strong class="font-medium text-white"><%= fmt.date(nf.minute, zone) %></strong>. The lunar cycle is 29.5 days, so only February, which is shorter, can occasionally miss a full moon.</p>
    <div class="mt-6"><%= render "tools/moon/tz_form", action: request.path, tone: :dark %></div>
  </div>
</section>
<% end %>

<!-- Phases -->
<section class="px-5 pb-2 pt-10 sm:px-11" data-screen-label="Phases">
  <h2 class="text-[21px] font-semibold text-ink">Moon phases in <%= @month_label %></h2>
  <p class="mb-5 mt-1 text-[13px] font-light text-muted">Times in <%= fmt.zone_label((@phases.first&.minute || Time.utc(@year, @mon, 15)), zone) %>. Moon signs use the tropical zodiac.</p>
  <div class="grid gap-[14px] sm:grid-cols-2 lg:grid-cols-4">
    <% @phases.each do |p| %>
      <% pt = p.minute %>
      <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
        <div class="flex items-center justify-between">
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint"><%= p.label %></div>
          <span aria-hidden="true"><%= render "tools/moon/moon_disc", angle: MoonCalendar::PHASE_ELONGATION[p.kind], size: 38, uid: "p#{p.stamp}", simple: true %></span>
        </div>
        <div class="mt-3 text-[17px] font-semibold text-ink"><time datetime="<%= pt.iso8601 %>"><%= fmt.short_date(pt, zone) %></time></div>
        <div class="text-[13px] font-light text-ui"><%= fmt.clock(pt, zone) %> <%= fmt.abbr(pt, zone) %></div>
        <div class="mt-3 text-[12.5px] font-light text-muted"><%= p.glyph %> <%= p.sign_label %> · <%= p.element %></div>
      </div>
    <% end %>
  </div>

  <% if @full %>
  <div class="mt-[18px] overflow-x-auto rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">The <%= @month_label %> full moon around the world</div>
    <table class="mt-3 w-full min-w-[420px] text-left text-[13px]">
      <caption class="sr-only">Full moon time by city</caption>
      <thead><tr class="text-[11px] font-medium text-faint"><th scope="col" class="pb-2 pr-4 font-medium">Where</th><th scope="col" class="pb-2 pr-4 font-medium">Date</th><th scope="col" class="pb-2 font-medium">Time</th></tr></thead>
      <tbody>
        <% @full_moons.each do |fm| %>
          <% fmt::COMPARE_ZONES.each do |label, id| %>
            <% z = ActiveSupport::TimeZone[id] %>
            <tr class="border-t border-violet/10"><th scope="row" class="py-2 pr-4 font-medium text-ink"><%= label %><%= " (#{fm.minute.strftime('%b %-d')} full moon)" if @full_moons.size > 1 %></th><td class="py-2 pr-4 font-light text-ui"><%= fmt.short_date(fm.minute, z) %></td><td class="py-2 font-light text-ui"><%= fmt.clock(fm.minute, z) %> <%= fmt.abbr(fm.minute, z) %></td></tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</section>

<% @guides.each_with_index do |(fm, g), i| %>
<section class="px-5 pb-2 pt-12 sm:px-11">
  <%= render "tools/moon/guidance", guide: g, id: (i.zero? ? "guidance" : "guidance-#{i + 1}"),
             heading: "What to charge at the #{fmt.day_month(fm.minute, zone)} #{g.title_name}" %>
</section>
<% end %>

<% if @new_guide %>
<section class="px-5 pb-2 pt-12 sm:px-11" data-screen-label="New moon">
  <% nm = @new_guide.event %>
  <h2 class="text-[21px] font-semibold text-ink">The <%= fmt.day_month(nm.minute, zone) %> new moon in <%= nm.sign_label %></h2>
  <p class="mt-3 max-w-[720px] text-[14px] font-light leading-[1.75] text-ui"><%= @new_guide.intro %> <%= @new_guide.element_note %></p>
  <div class="mt-4 flex flex-wrap items-center gap-[6px]">
    <span class="mr-1 text-[12.5px] text-ink">Stones to cleanse and set intentions with:</span>
    <% (@new_guide.charge.map(&:stone) + @new_guide.always.map(&:stone)).first(6).each do |s| %><%= render "tools/moon/stone_pill", stone: s %><% end %>
  </div>
</section>
<% end %>

<!-- Prev / next -->
<section class="px-5 pb-2 pt-12 sm:px-11" data-screen-label="Month navigation">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <% if @prev %><a href="<%= tools_moon_month_path(month: @prev, tz: tz_param) %>" class="rounded-full border border-violet/15 bg-white/80 px-5 py-[10px] text-[13px] font-medium text-ink hover:border-violet/40">← <%= Date.parse("#{@prev}-01").strftime("%B %Y") %></a><% else %><span></span><% end %>
    <a href="<%= tools_moon_path(tz: tz_param) %>" class="text-[13px] font-medium">Next full moon and the 13-month list →</a>
    <% if @next %><a href="<%= tools_moon_month_path(month: @next, tz: tz_param) %>" class="rounded-full border border-violet/15 bg-white/80 px-5 py-[10px] text-[13px] font-medium text-ink hover:border-violet/40"><%= Date.parse("#{@next}-01").strftime("%B %Y") %> →</a><% end %>
  </div>
  <div class="mt-6 flex flex-wrap gap-[6px]">
    <% (1..12).each do |m| %>
      <% key = fmt.month_param(@year, m) %>
      <a href="<%= tools_moon_month_path(month: key, tz: tz_param) %>" class="rounded-full px-[13px] py-[6px] text-[11.5px] leading-none <%= m == @mon ? "bg-ink text-white hover:text-white" : "bg-violet/8 text-violet-deep hover:bg-violet/14" %>"><%= Date::ABBR_MONTHNAMES[m] %> <%= @year %></a>
    <% end %>
  </div>
</section>

<section class="px-5 pb-12 pt-12 sm:px-11"><%= render "tools/moon/subscribe" %></section>

<section class="px-5 pb-16 sm:px-11" data-screen-label="FAQ">
  <h2 class="text-[21px] font-semibold text-ink">Questions about the <%= @month_label %> moon</h2>
  <dl class="mt-4 max-w-[760px] space-y-4">
    <% faq.each do |q, a| %>
      <div class="rounded-[16px] border border-violet/10 bg-white/80 px-[20px] py-4"><dt class="text-[14px] font-medium text-ink"><%= q %></dt><dd class="mt-1 text-[13px] font-light leading-[1.7] text-ui"><%= a %></dd></div>
    <% end %>
  </dl>
  <p class="mt-4 max-w-[760px] text-[11.5px] font-light leading-[1.6] text-faint">Dates are calculated from Meeus's lunar algorithms and match the US Naval Observatory to within about a minute. Moon sign, names and rituals are tradition.</p>
</section>
</div>
