<%# locals: title, eyebrow %>
<section class="px-5 pb-14 pt-9 sm:px-11">
  <%= render "shared/breadcrumb", crumbs: [["Home", root_path], [title, nil]] %>
  <h1 class="mt-3 text-[30px] font-light text-ink sm:text-[36px]"><%= title %> <span class="text-gradient font-semibold"><%= eyebrow %></span></h1>
  <div class="article mt-8"><%= yield %></div>
</section>
