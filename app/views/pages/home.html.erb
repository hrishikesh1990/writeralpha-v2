<% content_for :nav_cta, "1" %>

<!-- Hero -->
<section class="relative px-5 pb-14 pt-16 text-center sm:px-11" data-screen-label="Hero">
  <div class="glow-blob left-1/2 top-[10px] h-[320px] w-[560px] max-w-full -translate-x-1/2 blur-[34px]" aria-hidden="true"></div>
  <h1 class="relative mx-auto max-w-[680px] text-[36px] font-light leading-[1.12] text-ink sm:text-[52px]">Find the crystal<br><span class="text-gradient font-semibold">your energy is asking for</span></h1>
  <p class="relative mx-auto mb-[34px] mt-5 max-w-[460px] text-[15px] font-light leading-[1.7] text-muted"><%= @gemstone_count %> stones, 11 ways to search — by color, healing power, zodiac, birth month and more.</p>
  <form action="<%= gemstones_path %>" method="get" role="search" class="relative inline-flex w-[480px] max-w-full items-center justify-between gap-[10px] rounded-full border border-violet/18 bg-white/78 py-2 pl-6 pr-2 shadow-search">
    <input type="search" name="q" placeholder="Try &quot;crystals for sleep&quot;…" aria-label="Search stones" class="min-w-0 flex-1 border-0 bg-transparent font-sans text-[14px] text-ink outline-none placeholder:text-placeholder">
    <button type="submit" class="shrink-0 rounded-full bg-[linear-gradient(90deg,#7c3aed,#6d28d9)] px-6 py-[11px] text-[13px] font-medium text-white">Search</button>
  </form>
  <div class="relative mt-6 flex flex-wrap justify-center gap-2">
    <% [
      ["For sleep",      gemstones_by_healing_path(value: "sleep")],
      ["For protection", gemstones_by_healing_path(value: "protection")],
      ["By zodiac",      gemstones_path(anchor: "filter-zodiac")],
      ["By birth month", gemstones_by_birth_month_path(value: Date.current.strftime("%B").downcase)],
      ["By color",       gemstones_path(anchor: "filter-color")]
    ].each do |label, path| %>
      <a href="<%= path %>" class="rounded-full border border-ui/15 bg-white/70 px-4 py-2 text-[12px] text-ui card-transition hover:border-violet/40 hover:text-violet-deep"><%= label %></a>
    <% end %>
  </div>
</section>

<!-- Browse by -->
<section class="px-5 pb-6 pt-2 sm:px-11" data-screen-label="Browse by">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <% [
      ["◐", "By color",         "#{@color_count} colors, pink to gold", gemstones_path(anchor: "filter-color")],
      ["✦", "By healing power", "#{@healing_power_count} properties",   gemstones_path(anchor: "filter-healing")],
      ["☾", "By birth month",   "Your birthstone",                      gemstones_by_birth_month_path(value: Date.current.strftime("%B").downcase)],
      [text_glyph("♒"), "By zodiac",        "All 12 signs",                          gemstones_path(anchor: "filter-zodiac")]
    ].each do |glyph, title, sub, path| %>
      <a href="<%= path %>" class="flex flex-col gap-2 rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft card-transition hover:border-violet/35 hover:shadow-tile-hover">
        <div class="text-[20px] text-ink"><%= glyph %></div>
        <div class="text-[14.5px] font-semibold text-ink"><%= title %></div>
        <div class="text-[11.5px] font-light text-muted"><%= sub %></div>
      </a>
    <% end %>
  </div>
</section>

<!-- Featured stones -->
<% if @featured_gemstones.any? %>
<section class="px-5 pb-6 pt-8 sm:px-11" data-screen-label="Featured stones">
  <div class="mb-5 flex items-baseline justify-between">
    <h2 class="text-[22px] font-semibold text-ink">Featured stones</h2>
    <a href="<%= gemstones_path %>" class="text-[12.5px] font-medium">View all <%= @gemstone_count %> →</a>
  </div>
  <div class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-4">
    <% @featured_gemstones.each do |gemstone| %>
      <%= render "gemstones/stone_card", gemstone: gemstone, variant: :home %>
    <% end %>
  </div>
</section>
<% end %>

<!-- Zodiac strip -->
<section class="px-5 pb-10 pt-8 sm:px-11" data-screen-label="Zodiac strip">
  <div class="relative overflow-hidden rounded-[24px] bg-ink/97 px-6 py-9 sm:px-10">
    <div class="glow-violet -right-10 -top-[60px] h-[240px] w-[320px] blur-[20px]" aria-hidden="true"></div>
    <div class="relative mb-6 flex items-center justify-between">
      <div>
        <h2 class="text-[20px] font-semibold text-white">Stones by zodiac sign</h2>
        <p class="mt-1 text-[12.5px] font-light text-white/55">Every sign has its allies</p>
      </div>
    </div>
    <div class="relative grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-12">
      <% @zodiac_signs.each do |sign| %>
        <a href="<%= gemstones_by_zodiac_path(value: sign.slug) %>" class="flex flex-col items-center gap-[6px] rounded-[14px] border border-white/8 bg-white/6 px-1 py-[14px] text-white card-transition hover:bg-white/14 hover:text-white">
          <span class="text-[18px] leading-none text-lavender"><%= text_glyph(sign.symbol) %></span>
          <span class="text-[10px] text-white/75"><%= sign.name %></span>
        </a>
      <% end %>
    </div>
  </div>
</section>
