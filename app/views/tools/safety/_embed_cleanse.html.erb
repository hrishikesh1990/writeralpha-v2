<%# locals: gemstone, entry (AtlasEntry or nil), guide %>
<% if local_assigns[:entry].present? && entry.respond_to?(:safe_cleanse_methods) && entry.safety("water").present? %>
  <% plan = CrystalSafety.common_methods([entry]) %>
  <section class="mt-10 max-w-[760px] rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft" aria-labelledby="cleanse-embed-title" data-screen-label="Safe cleansing methods">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Crystal Safety Checker · <%= entry.name %></div>
    <h2 id="cleanse-embed-title" class="mt-2 text-[18px] font-semibold leading-[1.3] text-ink">Which cleansing methods are safe for <%= entry.name %>?</h2>
    <div class="mt-4"><%= render "tools/safety/methods", plan: plan, multi: false %></div>
    <p class="mt-4 text-[12px] font-light leading-[1.7] text-faint">"Safe" means the method will not damage the stone. Whether any method cleanses a crystal is tradition, not a physical effect.</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px] font-medium">
      <a href="<%= tools_safety_path(stone: entry.slug) %>">Full <%= entry.name %> safety card →</a>
      <a href="<%= tools_safety_path(stones: [entry.slug], anchor: "plan") %>">Cleansing it with other stones? Plan it →</a>
    </div>
  </section>
<% end %>
