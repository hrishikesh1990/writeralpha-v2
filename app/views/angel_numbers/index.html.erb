<section class="px-5 pb-6 pt-9 sm:px-11">
  <%= render "shared/breadcrumb", crumbs: [["Home", root_path], ["Angel numbers", nil]] %>
  <h1 class="mt-3 text-[30px] font-light text-ink sm:text-[36px]">Angel numbers <span class="text-gradient font-semibold">— messages in repetition</span></h1>
  <p class="mt-2 text-[14px] font-light text-muted">Discover the spiritual meaning behind the numbers you keep seeing.</p>
</section>

<% if @articles.any? %>
<section class="px-5 pb-14 pt-4 sm:px-11">
  <h2 class="mb-5 text-[22px] font-semibold text-ink">Angel number guides</h2>
  <div class="grid grid-cols-1 gap-[14px] sm:grid-cols-2 lg:grid-cols-3">
    <% @articles.each do |a| %>
      <a href="<%= a.canonical_path %>" class="flex items-center gap-[14px] rounded-[16px] border border-violet/10 bg-white/80 px-[18px] py-4 card-transition hover:border-violet/35 hover:shadow-guide-hover">
        <span class="flex size-[38px] flex-none items-center justify-center rounded-[12px] bg-violet/8 text-[16px]">✦</span>
        <span class="text-[13px] font-medium leading-[1.4] text-ink"><%= a.title %></span>
        <span class="ml-auto text-arrow" aria-hidden="true">→</span>
      </a>
        <% end %>
  </div>
</section>
<% else %>
<section class="px-5 pb-14 pt-2 sm:px-11">
  <div class="py-16 text-center font-light text-muted">Angel number guides are being written. <a href="<%= gemstones_path %>" class="font-medium text-violet-deep">Explore the gemstone directory</a> in the meantime.</div>
</section>
<% end %>
