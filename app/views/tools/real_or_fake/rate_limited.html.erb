<section class="px-5 pb-20 pt-16 text-center sm:px-11">
  <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-faint">429 — a short breather</div>
  <h1 class="mx-auto mt-4 max-w-[640px] text-[30px] font-light leading-[1.15] text-ink sm:text-[40px]">The photo check needs <span class="text-gradient font-semibold">a few minutes</span></h1>
  <p class="mx-auto mt-5 max-w-[500px] text-[15px] font-light leading-[1.7] text-muted">You have used the photo check several times in a short while. Please try again in about ten minutes. The step-by-step checklist has no limit and works the same way.</p>
  <div class="mt-8 flex flex-wrap justify-center gap-2">
    <% if @entry %><a href="<%= rof_path(@entry) %>" class="rounded-full bg-ink px-5 py-[10px] text-[12.5px] font-medium text-white hover:bg-ink hover:text-white">Back to the <%= @entry.name %> checklist</a><% end %>
    <a href="<%= tools_real_or_fake_path %>" class="rounded-full border border-ui/15 bg-white/70 px-5 py-[10px] text-[12.5px] text-ui card-transition hover:border-violet/40 hover:text-violet-deep">Pick a stone</a>
  </div>
</section>
