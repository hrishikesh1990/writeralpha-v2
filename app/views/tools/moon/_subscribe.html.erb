<%# Calendar subscription block; uses site_base_url from Tools::MoonController %>
<%
  https_url = "#{site_base_url}#{tools_moon_feed_path}"
  webcal_url = https_url.sub(/\Ahttps?:/, "webcal:")
  google_url = "https://calendar.google.com/calendar/r?cid=#{CGI.escape(webcal_url)}"
  outlook_url = "https://outlook.live.com/calendar/0/addfromweb?url=#{CGI.escape(https_url)}&name=#{CGI.escape("Full & New Moon — WriterAlpha")}"
%>
<section id="subscribe" class="scroll-mt-6" data-screen-label="Subscribe" data-controller="moon-copy" data-moon-copy-text-value="<%= https_url %>">
  <div class="relative overflow-hidden rounded-[22px] bg-ink/97 px-6 py-7 sm:px-9 sm:py-8">
    <div class="pointer-events-none absolute -right-10 -top-12 h-[200px] w-[260px] blur-[18px]" style="background:radial-gradient(ellipse,rgba(124,58,237,0.5),transparent 70%)" aria-hidden="true"></div>
    <div class="relative">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Subscribe</div>
      <h2 class="mt-2 text-[22px] font-semibold leading-[1.25] text-white">Put every full and new moon in your calendar</h2>
      <p class="mt-2 max-w-[640px] text-[13.5px] font-light leading-[1.7] text-white/75">Two years of full and new moons, each with the Moon's sign, what to charge and the moon water caution. Your calendar shows each event in your own time zone and refreshes by itself. <a href="<%= tools_moon_feed_path(phases: "all") %>" class="text-lavender hover:text-white">Want quarter moons too?</a></p>
      <div class="mt-5 flex flex-wrap gap-[10px]">
        <a href="<%= webcal_url %>" data-turbo="false" class="rounded-full bg-white px-5 py-[10px] text-[12.5px] font-medium text-ink hover:bg-lavender hover:text-ink">Apple Calendar &amp; others (webcal)</a>
        <a href="<%= google_url %>" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-[10px] text-[12.5px] text-white/90 hover:text-white">Add to Google Calendar</a>
        <a href="<%= outlook_url %>" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-[10px] text-[12.5px] text-white/90 hover:text-white">Add to Outlook</a>
        <a href="<%= https_url %>" data-turbo="false" class="rounded-full border border-white/25 px-5 py-[10px] text-[12.5px] text-white/90 hover:text-white">Download .ics</a>
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <label for="feed-url" class="sr-only">Calendar feed address</label>
        <input id="feed-url" type="text" readonly value="<%= https_url %>" onfocus="this.select()" class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-4 py-[9px] font-mono text-[11.5px] text-white/90 sm:max-w-[460px]">
        <button type="button" data-action="moon-copy#copy" data-moon-copy-target="button" class="rounded-full bg-white/15 px-4 py-[9px] text-[12px] font-medium text-white hover:bg-white/25">Copy link</button>
      </div>
      <dl class="mt-6 grid gap-4 text-[12.5px] font-light leading-[1.65] text-white/70 sm:grid-cols-3">
        <div><dt class="font-medium text-white">Apple Calendar</dt><dd>Tap the webcal button and choose Subscribe. On a Mac: File, New Calendar Subscription, paste the link.</dd></div>
        <div><dt class="font-medium text-white">Google Calendar</dt><dd>Use the button, or on the web open Other calendars, From URL, and paste the link. Google refreshes subscribed calendars about once a day.</dd></div>
        <div><dt class="font-medium text-white">Outlook</dt><dd>Use the button, or Add calendar, Subscribe from web, and paste the link.</dd></div>
      </dl>
    </div>
  </div>
</section>
