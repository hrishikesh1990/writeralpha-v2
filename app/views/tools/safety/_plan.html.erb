<%# locals: plan, entries %>
<% rows = plan.rows %>
<% names = CrystalSafety.join_list(rows.map(&:name)) %>
<article class="overflow-hidden rounded-[22px] border border-violet/10 bg-white/85 shadow-card" aria-labelledby="plan-title" data-screen-label="Cleanse plan">
  <div class="relative bg-ink/97 px-[22px] py-6 sm:px-8">
    <div class="glow-violet -right-10 -top-10 h-[180px] w-[320px] blur-[30px]" aria-hidden="true"></div>
    <div class="relative">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Cleanse plan · <%= rows.size %> stones</div>
      <h2 id="plan-title" class="mt-2 max-w-[760px] text-[22px] font-semibold leading-[1.25] text-white sm:text-[26px]">Cleansing <%= names %> together</h2>
      <p class="mt-3 max-w-[720px] text-[14px] font-light leading-[1.75] text-lavender/90">
        <% if plan.safe_sentence %>
          Safe for every stone here: <strong class="font-medium text-white"><%= plan.safe_sentence %></strong>.
        <% else %>
          No cleansing method is safe for all of these stones together.
        <% end %>
        <% if plan.blocked_sentence %>
          Not for this set: <%= plan.blocked_sentence %>.
        <% end %>
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2" data-controller="safety-copy">
        <button type="button" data-action="safety-copy#copy" data-safety-copy-target="button" class="rounded-full bg-white/10 px-4 py-[8px] text-[12px] font-medium text-white ring-1 ring-inset ring-white/20 hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lavender">Copy link to this plan</button>
        <span class="text-[11.5px] text-lavender/80" data-safety-copy-target="status" role="status"></span>
      </div>
    </div>
  </div>

  <div class="px-[22px] py-6 sm:px-8">
    <%= render "tools/safety/methods", plan: plan, multi: true %>

    <h3 class="mt-7 text-[15px] font-semibold text-ink">Each stone on its own</h3>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      <% rows.each do |r| %>
        <% single = CrystalSafety.common_methods([r.entry]) %>
        <li class="flex items-center justify-between gap-3 rounded-[14px] border border-violet/10 bg-white/70 px-4 py-[10px]">
          <a href="<%= tools_safety_path(stone: r.slug) %>" class="text-[13px] font-medium text-ink hover:text-violet-deep"><%= r.name %></a>
          <span class="text-[11.5px] text-muted"><%= single.blocked.size + single.caution.size == 0 ? "Every method is safe" : "#{single.blocked.size} to avoid#{", #{single.caution.size} with care" if single.caution.any?}" %></span>
        </li>
      <% end %>
    </ul>

    <p class="mt-6 max-w-[720px] text-[12px] font-light leading-[1.7] text-faint">
      "Safe" here means the method will not damage the stone. Whether smoke, sound or moonlight cleanses anything is crystal tradition, not a physical effect. For real dirt, use a dry soft brush, or water where the stone allows it.
    </p>
  </div>
</article>
