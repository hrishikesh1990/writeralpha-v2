<%# locals: (stone:, best:, avoid:, context: nil) %>
<div class="flex flex-col gap-8">
  <section aria-labelledby="best-title">
    <div class="flex flex-wrap items-center gap-4">
      <%= compat_avatar(stone, size: 56) %>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-violet">Best partners</div>
        <h2 id="best-title" class="mt-1 text-[24px] font-semibold leading-[1.15] text-ink sm:text-[28px]">Crystals that go with <%= stone.name %></h2>
      </div>
    </div>
    <p class="mt-3 max-w-[640px] text-[13.5px] font-light leading-[1.75] text-ui">Ranked by the atlas: curated pairings first, then shared intentions, chakras, elements and energy tone<% if context %>, tuned for <%= CrystalCompatibility::CONTEXTS[context][:label].downcase %><% end %>. Pick any row for the full reasoning, including the practical care.</p>

    <% if best.any? %>
      <ol class="mt-5 flex flex-col gap-[10px]">
        <% best.each_with_index do |res, i| %>
          <%= render "tools/compatibility/partner_row", result: res, stone: stone, rank: i + 1, context: context %>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-5 rounded-[16px] border border-violet/10 bg-white/80 px-5 py-4 text-[13.5px] font-light text-ui">We do not have other stones profiled yet to compare with <%= stone.name %>. More are added regularly.</p>
    <% end %>
  </section>

  <section aria-labelledby="avoid-title">
    <h2 id="avoid-title" class="text-[20px] font-semibold text-ink">Avoid pairing <%= stone.name %> with</h2>
    <% if avoid.any? %>
      <p class="mt-2 text-[13px] font-light text-muted">Pairs that tradition or Vedic astrology says to keep apart.</p>
      <ul class="mt-4 flex flex-col gap-[10px]">
        <% avoid.each do |res| %>
          <%= render "tools/compatibility/partner_row", result: res, stone: stone, context: context %>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 rounded-[16px] border border-violet/10 bg-white/80 px-5 py-4 text-[13.5px] font-light leading-[1.7] text-ui">Nothing in the atlas tells you to keep <%= stone.name %> away from another stone. Hardness and cleansing still matter, so check any pair you plan to store together.</p>
    <% end %>
  </section>

  <%= tradition_note %>
</div>
