<% gemstone = @gemstone %>
<% html, headings = content_with_headings(@content) %>
<% other_guides = gemstone.available_sub_pages.reject { |g| g[:path] == @sub_page&.dig(:path) } %>
<% article_jsonld(headline: @page_title, description: @meta[:description], image: gemstone.featured_image_url, published: gemstone.created_at, modified: gemstone.updated_at) %>
<% faq_jsonld(html) %>
<% facts = gemstone_facts(gemstone).values_at(0, 1, 2, 3, 6).reject { |_, value| value == "—" } %>
<% section_label = (@sub_page&.dig(:path) || "guide").tr("-", " ") %>

<div class="grid items-start gap-11 px-5 pb-14 pt-7 sm:px-11 lg:grid-cols-[1fr_300px]">
  <!-- Article -->
  <article data-screen-label="Article">
    <%= render "shared/breadcrumb", crumbs: [["Home", root_path], ["Gemstones", gemstones_path], [gemstone.name, gemstone_path(gemstone)], [section_label, nil]] %>
    <h1 class="mt-4 text-[30px] font-semibold leading-[1.15] text-ink sm:text-[38px]"><%= light_ampersand(@page_title) %></h1>
    <div class="mt-4 flex flex-wrap items-center gap-[14px] text-[12px] font-light text-faint">
      <span class="size-[26px] rounded-full bg-[linear-gradient(145deg,#c4b5fd,#8a6fd0)]" aria-hidden="true"></span>
      <span>WriterAlpha Editorial</span><span>·</span><span>Updated <%= gemstone.updated_at.strftime("%b %Y") %></span>
      <span>·</span><span><%= reading_time(@content) %> min read</span>
    </div>

    <div class="relative mt-[26px] flex h-[220px] items-end justify-end overflow-hidden rounded-[22px] p-[14px] shadow-article-hero sm:h-[300px]" style="background:<%= stone_gradient(gemstone) %>">
      <% if gemstone.featured_image_url.present? %>
        <img src="<%= image_url_for(gemstone.featured_image_url) %>" alt="<%= gemstone.name %>" class="absolute inset-0 h-full w-full object-cover">
      <% end %>
    </div>

    <div class="article mt-8"><%= render_content(html) %></div>
  </article>

  <!-- Sidebar -->
  <aside class="flex flex-col gap-[18px] lg:sticky lg:top-4" data-screen-label="Sidebar">
    <% if headings.any? %>
      <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
        <div class="mb-[14px] font-mono text-[10px] uppercase tracking-[0.18em] text-faint">On this page</div>
        <nav class="flex flex-col gap-[11px]" aria-label="On this page">
          <% headings.each do |h| %>
            <a href="#<%= h[:id] %>" class="text-[12.5px] leading-[1.4] text-ui hover:text-violet-deep"><%= h[:title] %></a>
          <% end %>
        </nav>
      </div>
    <% end %>

    <div class="relative overflow-hidden rounded-[18px] bg-ink/97 px-[22px] py-5">
      <div class="absolute -right-[30px] -top-10 h-[140px] w-[180px] blur-[16px] pointer-events-none" style="background:radial-gradient(ellipse,rgba(124,58,237,0.55),transparent 70%)" aria-hidden="true"></div>
      <div class="relative mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-lavender"><%= other_guides.any? ? "More #{gemstone.name} guides" : "About #{gemstone.name}" %></div>
      <div class="relative flex flex-col gap-[10px]">
        <% other_guides.first(5).each do |guide| %>
          <a href="/gemstones/<%= gemstone.slug %>/<%= guide[:path] %>" class="flex items-baseline gap-[9px] text-[12.5px] leading-[1.4] text-white/85 hover:text-white"><span class="text-[11px]"><%= guide[:icon] %></span><%= guide[:short] %></a>
        <% end %>
      </div>
      <a href="<%= gemstone_path(gemstone) %>" class="relative mt-4 block text-[12px] font-medium text-lavender hover:text-white"><%= gemstone.name %> overview<%= other_guides.any? ? " & all #{other_guides.size + 1} guides" : "" %> →</a>
    </div>

    <% if facts.any? %>
    <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
      <div class="mb-[14px] font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Quick facts</div>
      <dl class="flex flex-col gap-[10px]">
        <% facts.each do |label, value| %>
          <div class="flex justify-between gap-4 text-[12px]">
            <dt class="font-light text-faint"><%= label %></dt>
            <dd class="text-right font-medium text-ink"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>
    <% end %>
  </aside>
</div>
