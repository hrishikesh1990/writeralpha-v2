<%# locals: hi, bn ([roman, script] pairs). Renders "Mesh (मेष · মেষ)" when both romanisations match, else "Vrishabh (वृषभ) · Brisha (বৃষ)". %><% if hi[0] == bn[0] %><%= hi[0] %> (<span lang="hi"><%= hi[1] %></span> · <span lang="bn"><%= bn[1] %></span>)<% else %><%= render "tools/birthstone/pair", pair: hi, code: "hi" %> · <%= render "tools/birthstone/pair", pair: bn, code: "bn" %><% end %>