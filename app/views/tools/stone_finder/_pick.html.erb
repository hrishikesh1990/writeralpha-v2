<%# locals: pick, rank, query %>
<%
  e = pick.entry
  caution = pick.caution
  tier = e.price_tier
  gem = e.respond_to?(:gemstone) ? e.gemstone : nil
  reason_icon = { intention: "✦", sign: "☽", birthstone: "◈", use: "✧", practical: "✓", easy: "✓", about: "·" }
%>
<article class="rounded-[20px] border border-violet/10 bg-white/85 shadow-card" aria-labelledby="pick-<%= e.slug %>">
  <div class="flex items-start gap-4 px-5 pb-4 pt-5 sm:px-6">
    <a href="<%= e.path %>" class="relative block size-[68px] flex-none overflow-hidden rounded-[16px] sm:size-[84px]" style="background:<%= gem ? stone_gradient(gem) : 'linear-gradient(145deg,#c4b5fd,#8a6fd0)' %>" tabindex="-1" aria-hidden="true">
      <% if e.image_url.present? %>
        <img src="<%= image_url_for(e.image_url) %>" alt="" width="84" height="84" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover">
      <% end %>
    </a>
    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-2">
        <span class="font-mono text-[11px] text-faint">#<%= rank %></span>
        <h3 id="pick-<%= e.slug %>" class="text-[19px] font-semibold leading-tight text-ink"><a href="<%= e.path %>" class="text-ink hover:text-violet-deep"><%= e.name %></a></h3>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-[6px]">
        <%= verdict_badge(nil, label: pick.fit[:label], tone: pick.fit[:tone]) %>
        <% if tier.present? %><%= verdict_badge(nil, label: "#{tier.capitalize} price", tone: :info) %><% end %>
      </div>
      <div class="mt-3 flex items-center gap-3" role="img" aria-label="Fit score <%= pick.score %> out of 100">
        <div class="h-[6px] flex-1 overflow-hidden rounded-full bg-violet/10"><div class="h-full rounded-full bg-gradient-to-r from-violet to-sky" style="width:<%= pick.score %>%"></div></div>
        <span class="font-mono text-[12px] font-medium text-violet-deep"><%= pick.score %><span class="text-faint">/100</span></span>
      </div>
    </div>
  </div>

  <div class="px-5 sm:px-6">
    <h4 class="font-mono text-[10px] font-normal uppercase tracking-[0.18em] text-faint">Why it fits</h4>
    <ul class="mt-2 flex flex-col gap-[7px]">
      <% pick.reasons.each do |r| %>
        <li class="flex gap-[10px] text-[13.5px] font-light leading-[1.6] text-ui"><span class="mt-[2px] w-[14px] flex-none text-center text-[11px] text-violet" aria-hidden="true"><%= reason_icon[r.kind] || "·" %></span><span><%= r.text %></span></li>
      <% end %>
    </ul>

    <div class="mt-4 flex flex-wrap gap-[6px]">
      <% { "water" => "Water: ", "sleep" => "Sleep: ", "wear" => "" }.each do |key, prefix| %>
        <% v = e.safety(key) %>
        <% next if v.blank? %>
        <%= verdict_badge(v, label: "#{prefix}#{verdict_label(v)}") %>
      <% end %>
      <% if e.toxicity.present? && e.toxicity != "none" %><%= verdict_badge(e.toxicity, label: "Toxicity: #{verdict_label(e.toxicity)}") %><% end %>
    </div>
  </div>

  <% if caution %>
    <div class="mx-5 mt-4 rounded-[14px] border border-amber-600/20 bg-amber-500/8 px-4 py-3 sm:mx-6">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-amber-800">Check before you buy</div>
      <p class="mt-[6px] text-[12.5px] font-light leading-[1.65] text-ui"><strong class="font-medium text-ink"><%= caution[:who] %>.</strong> <%= caution[:why] %></p>
    </div>
  <% end %>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-violet/8 px-5 py-3 text-[12.5px] font-medium sm:px-6">
    <a href="<%= e.path %>">Read the <%= e.name %> guide →</a>
    <% if e.guide?("who-should-not-wear") %><a href="<%= e.guide_path('who-should-not-wear') %>">Who should not wear it</a><% end %>
    <a href="<%= tools_real_or_fake_path(stone: e.slug) %>">Is yours real?</a>
  </div>

  <details class="border-t border-violet/8 px-5 py-3 text-[12.5px] sm:px-6">
    <summary class="cursor-pointer select-none font-medium text-muted hover:text-violet-deep">How this score is built</summary>
    <table class="mt-3 w-full text-left text-[12px] font-light">
      <caption class="sr-only">Points behind the fit score for <%= e.name %></caption>
      <thead><tr class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint"><th scope="col" class="pb-2 font-normal">Part</th><th scope="col" class="pb-2 text-right font-normal">Points</th></tr></thead>
      <tbody>
        <% pick.parts.each do |part| %>
          <tr class="border-t border-violet/8"><th scope="row" class="py-[6px] font-light text-ui"><%= part.label %></th><td class="py-[6px] text-right font-mono text-ink"><%= part.points.round(1).to_s.delete_suffix(".0") %> <span class="text-faint">of <%= part.max.round.to_s %></span></td></tr>
        <% end %>
        <% total = pick.parts.sum(&:points); possible = pick.parts.sum(&:max) %>
        <tr class="border-t border-violet/15 font-medium"><th scope="row" class="py-[6px] text-ink">Total</th><td class="py-[6px] text-right font-mono text-ink"><%= total.round(1).to_s.delete_suffix(".0") %> of <%= possible.round %> = <%= pick.score %></td></tr>
      </tbody>
    </table>
  </details>
</article>
