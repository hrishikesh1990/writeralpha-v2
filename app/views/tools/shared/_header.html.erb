<%# locals: title, lede, eyebrow, crumbs %>
<section class="relative overflow-x-clip px-5 pb-4 pt-9 sm:px-11" data-screen-label="Tool header">
  <div class="glow-blob -top-10 left-1/3 h-[220px] w-[420px] blur-[30px]" aria-hidden="true"></div>
  <div class="relative">
    <%= render "shared/breadcrumb", crumbs: crumbs %>
    <div class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-violet"><%= eyebrow %></div>
    <h1 class="mt-2 max-w-[820px] text-[32px] font-semibold leading-[1.1] text-ink sm:text-[42px]"><%= light_ampersand(title) %></h1>
    <p class="mt-3 max-w-[680px] text-[15px] font-light leading-[1.7] text-ui"><%= lede %></p>
  </div>
</section>
