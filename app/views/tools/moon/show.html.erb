<% noindex_when_params!(:tz) %>
<% tool_jsonld(name: "Moon Cleansing Calendar", description: "Full moon and new moon dates and times in your time zone, the Moon's zodiac sign, which crystals to charge and which stones must stay out of moon water, with a subscribable calendar.", path: tools_moon_path) %>
<% full = @next_full; t = full.minute %>

<%= tool_header(title: "Full Moon Calendar for Crystal Cleansing", eyebrow: "— moon cleansing calendar",
                lede: "Exact full and new moon times in your time zone, the Moon's zodiac sign, which crystals to charge, which stones to keep out of moon water, and a calendar you can subscribe to.",
                crumbs: [["Home", root_path], ["Tools", tools_path], ["Moon Calendar", nil]]) %>

<div data-controller="moon-timezone" data-moon-timezone-current-value="<%= tz_param %>" data-moon-timezone-explicit-value="<%= params[:tz].present? %>" data-moon-timezone-base-value="<%= tools_moon_path %>">
<!-- Hero -->
<section class="px-5 pb-2 pt-4 sm:px-11" data-screen-label="Next full moon">
  <div class="relative overflow-hidden rounded-[26px] bg-ink/97 px-6 py-8 sm:px-10 sm:py-10">
    <div class="pointer-events-none absolute -right-16 -top-16 h-[320px] w-[420px] blur-[22px]" style="background:radial-gradient(ellipse,rgba(124,58,237,0.5),transparent 70%)" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 opacity-60" aria-hidden="true" style="background-image:radial-gradient(1px 1px at 12% 22%,#fff,transparent),radial-gradient(1px 1px at 34% 70%,#c4b5fd,transparent),radial-gradient(1.5px 1.5px at 58% 16%,#fff,transparent),radial-gradient(1px 1px at 80% 82%,#fff,transparent),radial-gradient(1px 1px at 92% 38%,#c4b5fd,transparent),radial-gradient(1px 1px at 6% 88%,#fff,transparent)"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_230px]">
      <div class="min-w-0">
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-lavender">Next full moon</div>
        <h2 class="mt-3 text-[26px] font-semibold leading-[1.2] text-white sm:text-[34px]">
          <time datetime="<%= t.iso8601 %>"><%= fmt.date(t, zone) %>, <%= fmt.clock(t, zone) %></time>
          <span class="mt-1 block text-[16px] font-light text-white/70 sm:text-[18px]"><%= fmt.zone_label(t, zone) %></span>
        </h2>
        <p class="mt-3 text-[16px] font-light text-lavender"><%= fmt.countdown(full.time, @now) %></p>
        <p class="mt-4 max-w-[560px] text-[14px] font-light leading-[1.7] text-white/80">
          The <strong class="font-medium text-white"><%= @next_name %></strong><%= " (#{@next_aka})" if @next_aka %> falls with the Moon in
          <strong class="font-medium text-white"><%= full.glyph %> <%= full.sign_label %></strong>, <%= fmt.indefinite(full.element) %> sign.
          <%= "It is also a Blue Moon, the second full moon this month." if @next_blue %>
          <a href="#next-guidance" class="text-lavender hover:text-white">What to charge →</a>
          <a href="#subscribe" class="whitespace-nowrap text-lavender hover:text-white">Subscribe →</a>
        </p>
        <% if @recent_full %>
          <p class="mt-3 max-w-[560px] rounded-[14px] bg-white/8 px-4 py-3 text-[12.5px] font-light leading-[1.6] text-white/80">The last full moon was <%= fmt.countdown(@recent_full.time, @now) %> (<%= fmt.date(@recent_full.minute, zone) %>, <%= fmt.clock(@recent_full.minute, zone) %>). Tradition says the nights either side of the full moon work as well as the exact minute, so tonight still counts.</p>
        <% end %>
        <div class="mt-6"><%= render "tools/moon/tz_form", action: tools_moon_path, tone: :dark %></div>
      </div>
      <div class="flex flex-col items-center text-center">
        <%= render "tools/moon/moon_disc", angle: @state[:angle], size: 190, uid: "hero", label: "The Moon today: #{@state[:name]}, #{(@state[:illumination] * 100).round}% lit" %>
        <div class="mt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Today</div>
        <div class="mt-1 text-[15px] font-medium text-white"><%= @state[:name] %></div>
        <div class="text-[12px] font-light text-white/65"><%= (@state[:illumination] * 100).round %>% lit, northern hemisphere view</div>
      </div>
    </div>
  </div>
</section>

<!-- Guidance for the next full moon -->
<section class="px-5 pb-2 pt-10 sm:px-11">
  <%= render "tools/moon/guidance", guide: @guide, id: "next-guidance",
             heading: "What to do at the #{fmt.day_month(t, zone)} #{@next_name}" %>
</section>

<!-- Timeline -->
<section class="px-5 pb-2 pt-12 sm:px-11" data-screen-label="Next 13 lunations">
  <h2 class="text-[21px] font-semibold text-ink">The next 13 full moons</h2>
  <p class="mb-5 mt-1 text-[13px] font-light text-muted">Each full moon with the new moon that follows it, shown in <%= fmt.zone_name(zone) %><%= ", as local clock times with daylight saving applied" unless fmt.zone_id(zone) == "UTC" %>. Open a month for the full guide.</p>
  <ol class="overflow-hidden rounded-[18px] border border-violet/10 bg-white/80">
    <% @lunations.each_with_index do |l, i| %>
      <% f = l[:full]; n = l[:new_moon]; ft = f.minute; nt = n.minute %>
      <li class="grid items-center gap-x-6 gap-y-2 px-[22px] py-4 sm:grid-cols-[1.4fr_1fr_1fr] <%= "border-t border-violet/10" if i.positive? %> <%= "bg-violet/[0.04]" if i.zero? %>">
        <div class="flex items-center gap-4">
          <span class="flex-none" aria-hidden="true"><%= render "tools/moon/moon_disc", angle: 180, size: 38, uid: "tf#{i}", simple: true %></span>
          <div>
            <a href="<%= tools_moon_month_path(month: fmt.month_param(*fmt.local(ft, zone).then { |d| [d.year, d.month] }), tz: tz_param) %>" class="text-[14.5px] font-medium text-ink hover:text-violet-deep">
              <time datetime="<%= ft.iso8601 %>"><%= fmt.short_date(ft, zone) %> <%= fmt.local(ft, zone).year %>, <%= fmt.clock(ft, zone) %> <%= fmt.abbr(ft, zone) %></time>
            </a>
            <div class="mt-1 flex flex-wrap items-center gap-[6px] text-[12px] font-light text-muted">
              <span><%= l[:name][0] %></span>
              <% if i.zero? %><%= verdict_badge(nil, label: "Next", tone: :info) %><% end %>
              <% if l[:blue] %><%= verdict_badge(nil, label: "Blue Moon", tone: :info) %><% end %>
            </div>
          </div>
        </div>
        <div class="text-[13px] font-light text-ui"><span class="font-medium text-ink"><%= f.glyph %> <%= f.sign_label %></span><span class="text-muted"> · <%= f.element %></span></div>
        <div class="flex items-center gap-3 text-[13px] font-light text-ui">
          <span class="flex-none" aria-hidden="true"><%= render "tools/moon/moon_disc", angle: 0, size: 22, uid: "tn#{i}", simple: true %></span>
          <div><span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-faint">New moon after</span><%= fmt.short_date(nt, zone) %> <span class="text-muted">· <%= n.glyph %> <%= n.sign_label %></span></div>
        </div>
      </li>
    <% end %>
  </ol>
  <p class="mt-3 text-[11.5px] font-light leading-[1.6] text-faint">Moon sign uses the tropical (Western) zodiac. At a full moon the Moon is opposite the Sun; at a new moon it is with the Sun.</p>
</section>

<!-- Subscribe -->
<section class="px-5 pb-2 pt-12 sm:px-11"><%= render "tools/moon/subscribe" %></section>

<!-- Browse months -->
<section class="px-5 pb-2 pt-12 sm:px-11" data-screen-label="Months">
  <h2 class="text-[21px] font-semibold text-ink">Full moon by month</h2>
  <p class="mb-5 mt-1 text-[13px] font-light text-muted">Every month has its own page with all four phases, the full moon's name and sign, and what to charge.</p>
  <div class="grid grid-cols-2 gap-[10px] sm:grid-cols-3 lg:grid-cols-6">
    <% start = Date.new(@now.year, @now.month, 1) %>
    <% 12.times do |i| %>
      <% d = start >> i %>
      <a href="<%= tools_moon_month_path(month: d.strftime("%Y-%m"), tz: tz_param) %>" class="rounded-[14px] border border-violet/10 bg-white/80 px-[14px] py-3 text-[13px] font-medium text-ink card-transition hover:border-violet/35">
        <%= d.strftime("%B %Y") %>
      </a>
    <% end %>
  </div>
</section>

<!-- Method -->
<section class="px-5 pb-16 pt-12 sm:px-11" data-screen-label="About the dates">
  <div class="max-w-[760px] rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">About these dates</div>
    <p class="mt-3 text-[13px] font-light leading-[1.75] text-ui">Phase times are calculated from Jean Meeus's lunar algorithms and agree with the US Naval Observatory to within about a minute, for any date from 1950 to 2100. The full moon is the instant the Moon is exactly opposite the Sun, so it lasts a moment; the Moon looks full for a night or two either side. Full moon names come from North American almanac tradition. A Blue Moon is counted as the second full moon in a calendar month, by the dates in the time zone shown.</p>
    <p class="mt-3 text-[13px] font-light leading-[1.75] text-ui">Tell us your time zone with the menu above and every time on this page and the month pages follows. Your calendar subscription needs no setting: it stores the moment in UTC and your calendar shows it in local time.</p>
    <%= tradition_note %>
  </div>
</section>
</div>
