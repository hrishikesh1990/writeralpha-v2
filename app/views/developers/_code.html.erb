<%# locals: label, code, scroll (optional max height class) %>
<div class="overflow-hidden rounded-[16px] bg-ink/97 shadow-card-soft" data-controller="developers-copy">
  <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-[9px]">
    <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-lavender"><%= label %></span>
    <button type="button" hidden data-developers-copy-target="button" data-action="developers-copy#copy" class="rounded-full bg-white/10 px-3 py-[5px] font-mono text-[10px] uppercase tracking-[0.12em] text-white card-transition hover:bg-white/20">Copy</button>
  </div>
  <pre class="<%= local_assigns[:scroll] %> overflow-auto px-4 py-4 font-mono text-[12.5px] leading-[1.7] text-white/90" tabindex="0"><code data-developers-copy-target="source"><%= code %></code></pre>
</div>
