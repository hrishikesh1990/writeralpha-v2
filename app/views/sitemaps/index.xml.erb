<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc><%= canonical_url("/") %></loc><priority>1.0</priority></url>
  <url><loc><%= canonical_url(gemstones_path) %></loc><priority>0.9</priority></url>
  <% @gemstones.each do |g| %>
  <url><loc><%= canonical_url(gemstone_path(g)) %></loc><lastmod><%= g.updated_at.strftime("%Y-%m-%d") %></lastmod><priority>0.7</priority></url>
  <% g.available_sub_pages.each do |sp| %>
  <url><loc><%= canonical_url("/gemstones/#{g.slug}/#{sp[:path]}") %></loc><lastmod><%= g.updated_at.strftime("%Y-%m-%d") %></lastmod><priority>0.8</priority></url>
  <% end %>
  <% end %>
  <% @filter_pages.each do |path| %>
  <url><loc><%= canonical_url(path) %></loc><priority>0.5</priority></url>
  <% end %>
  <% @articles.each do |a| %>
  <url><loc><%= canonical_url(a.canonical_path) %></loc><lastmod><%= a.updated_at.strftime("%Y-%m-%d") %></lastmod><priority>0.8</priority></url>
  <% end %>
  <% %w[/about /contact /write-for-us].each do |path| %>
  <url><loc><%= canonical_url(path) %></loc><priority>0.3</priority></url>
  <% end %>
</urlset>
