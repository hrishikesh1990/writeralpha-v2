<%# locals: test (AuthenticityCheck::Test), number, answer ("real"/"fake"/"unsure"/"skipped"/nil) %>
<fieldset id="test-<%= test.id %>" data-step data-answered="<%= answer.present? %>"
          class="group/step scroll-mt-4 rounded-[18px] border border-violet/10 bg-white/80 px-[18px] py-5 card-transition has-[:checked]:border-violet/25 sm:px-[22px] <%= 'border-amber-600/20' if test.destructive? %>">
  <legend class="sr-only"><%= test.title %> test, step <%= number %></legend>
  <div class="grid grid-cols-[32px_minmax(0,1fr)] gap-x-3.5 gap-y-3">
    <span class="flex size-8 flex-none self-start items-center justify-center rounded-full bg-violet/8 font-mono text-[12px] text-violet-deep card-transition group-has-[:checked]/step:bg-violet group-has-[:checked]/step:text-white" aria-hidden="true">
      <span class="group-has-[:checked]/step:hidden"><%= number %></span><span class="hidden group-has-[:checked]/step:inline">✓</span>
    </span>
    <div class="min-w-0 self-center">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <h3 class="text-[16.5px] font-semibold leading-snug text-ink"><%= test.title %></h3>
        <span class="inline-flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-[0.12em] text-muted">
          <span class="flex gap-[3px]" aria-hidden="true"><%= rof_dots(test.weight) %></span><%= test.weight_label %>
        </span>
        <% if test.destructive? %><%= verdict_badge(nil, label: "May mark the stone", tone: :warn) %><% end %>
      </div>
    </div>
    <div class="col-span-2 min-w-0 sm:col-span-1 sm:col-start-2">
      <% if test.how.present? %>
        <p class="text-[14px] font-light leading-[1.75] text-ui"><span class="font-medium text-ink">What to do: </span><%= test.how %></p>
      <% end %>
      <% if test.real.present? || test.fake.present? %>
        <dl class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
          <% if test.real.present? %>
            <div class="rounded-[12px] bg-emerald-500/7 px-3.5 py-3">
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-emerald-800">Real usually looks like</dt>
              <dd class="mt-1.5 text-[13.5px] font-light leading-[1.65] text-ui"><%= test.real %></dd>
            </div>
          <% end %>
          <% if test.fake.present? %>
            <div class="rounded-[12px] bg-amber-500/9 px-3.5 py-3">
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-amber-800">A fake often looks like</dt>
              <dd class="mt-1.5 text-[13.5px] font-light leading-[1.65] text-ui"><%= test.fake %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>

      <div class="mt-4" role="radiogroup" aria-label="What did you see for <%= test.title.downcase %>?">
        <div class="grid grid-cols-3 gap-2">
          <% RealOrFakeHelper::ROF_CHOICES.each do |value, label| %>
            <label class="relative block">
              <input type="radio" name="a[<%= test.id %>]" value="<%= value %>" class="<%= RealOrFakeHelper::ROF_INPUT %>" <%= "checked" if answer == value %>>
              <span class="<%= rof_choice_pill(value) %>"><%= label %></span>
            </label>
          <% end %>
        </div>
        <label class="relative -ml-3.5 mt-1 inline-flex">
          <input type="radio" name="a[<%= test.id %>]" value="skipped" class="<%= RealOrFakeHelper::ROF_INPUT %>" <%= "checked" if answer == "skipped" %>>
          <span class="<%= RealOrFakeHelper::ROF_SKIP_PILL %>">Skip this test</span>
        </label>
      </div>
    </div>
  </div>
</fieldset>
