<%# locals: wd (Weekday), lang, t %>
<% rn = wd.ratna %>
<% big = lang == "en" ? rn.name : (rn.pair(lang)&.last || rn.name) %>
<article class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5" aria-labelledby="bs-day-h" data-screen-label="Weekday card">
  <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted"><%= t.(:eyebrow_weekday) %></div>
  <h2 id="bs-day-h" class="mt-2 text-[21px] font-semibold text-ink"><%= t.(:your_weekday) %></h2>
  <p class="mt-1 text-[13px] font-light text-muted"><%= t.(:born_on, day: BirthstoneCalculator.weekday_name(wd.wday, lang)) %></p>
  <div class="mt-4">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-[14px] bg-violet/5 px-4 py-3">
      <div>
        <div class="text-[11px] font-light text-muted"><%= t.(:weekday_planet) %>: <%= lang == "en" ? rn.graha_en : tag.span(rn.graha_pair(lang).last || rn.graha_en, lang: lang) %></div>
        <div class="text-[17px] font-semibold leading-[1.35] text-ink"><%= lang == "en" ? big : tag.span(big, lang: lang) %><% if lang != "en" %> <span class="text-[12px] font-light text-muted"><%= rn.name %></span><% end %></div>
        <div class="mt-[2px] text-[11.5px] font-light text-muted"><%= render "tools/birthstone/pair_both", hi: rn.hi, bn: rn.bn %></div>
      </div>
      <% if rn.live? %><a href="<%= rn.path %>" class="inline-flex min-h-[32px] items-center gap-1 text-[12.5px] font-medium"><%= t.(:guide_link, stone: (lang == "en" ? rn.entry.name : (rn.pair(lang)&.last || rn.entry.name))) %> →</a><% end %>
    </div>
  </div>
  <p class="mt-4 text-[12.5px] font-light leading-[1.7] text-ui"><%= t.(:weekday_note) %></p>
</article>
