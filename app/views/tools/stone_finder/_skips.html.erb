<%# locals: skips, query %>
<%
  labels = { safety: ["Safety", :bad], tradition: ["Tradition", :info], zodiac: ["Tradition", :info], setting: ["Your settings", :warn] }
  visible = skips.first(6)
  more = skips.drop(6)
  row = lambda do |skip|
    e = skip.entry
    content_tag(:li, class: "rounded-[16px] border border-violet/10 bg-white/85 px-4 py-4 sm:px-5") do
      safe_join([
        content_tag(:div, class: "flex flex-wrap items-center justify-between gap-2") do
          safe_join([link_to(e.name, e.path, class: "text-[15px] font-semibold text-ink hover:text-violet-deep"),
                     (link_to("Who should not wear it", e.guide_path("who-should-not-wear"), class: "text-[12px] font-medium") if e.guide?("who-should-not-wear"))].compact)
        end,
        content_tag(:ul, class: "mt-2 flex flex-col gap-[8px]") do
          safe_join(skip.reasons.first(3).map do |r|
            label, tone = labels.fetch(r.kind, ["Note", :info])
            content_tag(:li, class: "flex flex-col items-start gap-[6px] text-[13px] font-light leading-[1.65] text-ui sm:flex-row sm:gap-3") do
              safe_join([content_tag(:span, verdict_badge(nil, label: label, tone: tone), class: "flex-none sm:mt-[2px]"), content_tag(:span, r.text)])
            end
          end)
        end
      ])
    end
  end
%>
<section aria-labelledby="skip-heading">
  <h2 id="skip-heading" class="text-[21px] font-semibold text-ink">Skip these</h2>
  <p class="mt-1 text-[13px] font-light text-muted">Stones that would otherwise suit you, and the specific reason to leave each one for now.</p>
  <ul class="mt-4 flex flex-col gap-3">
    <% visible.each { |skip| %><%= row.call(skip) %><% } %>
  </ul>
  <% if more.any? %>
    <details class="mt-3">
      <summary class="cursor-pointer select-none text-[12.5px] font-medium text-violet-deep">Show <%= more.size %> more</summary>
      <ul class="mt-3 flex flex-col gap-3">
        <% more.each { |skip| %><%= row.call(skip) %><% } %>
      </ul>
    </details>
  <% end %>
</section>
