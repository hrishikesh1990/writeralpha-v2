<%# No stone chosen: searchable picker + "most faked" quick links. Uses @entries (stones that have tests). %>
<%= tool_header(title: "Real or Fake? Check Your Stone",
                eyebrow: "— authenticity checker",
                lede: "Pick a stone and we will walk you through the home tests that separate the real thing from dyed, glass and resin imitations, scoring the evidence as you go. Calm, step by step, no sign-up.",
                crumbs: [["Home", root_path], ["Tools", tools_path], ["Real or Fake?", nil]]) %>

<section class="px-5 pb-4 pt-6 sm:px-11" data-screen-label="Stone picker" data-controller="real-or-fake-picker">
  <% if @unknown_stone %>
    <div class="mb-5 rounded-[16px] border border-amber-600/25 bg-amber-500/10 px-5 py-4 text-[13.5px] leading-[1.65] text-amber-900" role="status">
      We do not have a checklist for “<%= @unknown_stone.truncate(40) %>” yet. Pick one of the stones below. More are added all the time.
    </div>
  <% end %>

  <% if @entries.empty? %>
    <div class="rounded-[18px] border border-violet/10 bg-white/80 px-6 py-8 text-center text-[14px] font-light text-muted">
      The identification checklists are being written. Please check back soon.
    </div>
  <% else %>
    <% top = AuthenticityCheck.most_faked(@entries, limit: 6) %>
    <div class="rounded-[22px] border border-violet/10 bg-white/85 p-5 shadow-card sm:p-7">
      <label for="rof-search" class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">Which stone do you have?</label>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row">
        <input id="rof-search" type="search" autocomplete="off" placeholder="Search: turquoise, amethyst, malachite…" hidden
               data-real-or-fake-picker-target="input" data-action="input->real-or-fake-picker#filter keydown.enter->real-or-fake-picker#go"
               class="min-h-[52px] w-full rounded-full border border-violet/15 bg-white px-6 text-[15px] text-ink shadow-search placeholder:text-muted focus:border-violet/50 focus:outline-none focus:ring-2 focus:ring-violet/30">
      </div>

      <% if top.any? %>
        <div class="mt-6">
          <h2 class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">Most faked stones</h2>
          <p class="mt-1 text-[13px] font-light text-muted">The ones where imitations are most common, so a check is most worthwhile.</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-real-or-fake-picker-target="top">
            <% top.each do |e| %>
              <a href="<%= tools_real_or_fake_path(stone: e.slug) %>" class="group flex items-center gap-3.5 rounded-[16px] border border-violet/10 bg-white px-3.5 py-3 card-transition hover:border-violet/35 hover:shadow-guide-hover">
                <span class="relative size-[52px] flex-none overflow-hidden rounded-[12px]" style="background:<%= stone_gradient(e.gemstone) %>">
                  <% if e.image_url.present? %><img src="<%= image_url_for(e.image_url) %>" alt="" class="absolute inset-0 size-full object-cover" loading="lazy" onerror="this.remove()"><% end %>
                </span>
                <span class="min-w-0">
                  <span class="block text-[14.5px] font-semibold text-ink"><%= e.name %></span>
                  <span class="block text-[11.5px] font-light text-muted"><%= pluralize(e.common_fakes.size, "common fake") %></span>
                </span>
                <span class="ml-auto text-arrow group-hover:text-violet" aria-hidden="true">→</span>
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-7">
        <h2 class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">All stones <span class="text-muted" data-real-or-fake-picker-target="count">(<%= @entries.size %>)</span></h2>
        <ul class="mt-3 flex flex-wrap gap-2" data-real-or-fake-picker-target="list">
          <% @entries.each do |e| %>
            <% search = ([e.name] + e.aka).join(" ").downcase %>
            <li data-real-or-fake-picker-target="item" data-search="<%= search %>">
              <a href="<%= tools_real_or_fake_path(stone: e.slug) %>" class="inline-flex min-h-[40px] items-center rounded-full border border-violet/12 bg-white px-4 text-[13px] text-ui card-transition hover:border-violet/40 hover:text-violet-deep"><%= e.name %></a>
            </li>
          <% end %>
        </ul>
        <p class="mt-4 hidden text-[13.5px] font-light text-muted" data-real-or-fake-picker-target="empty" role="status">No stone matches that yet. Try another spelling or a shorter name.</p>
      </div>
    </div>
  <% end %>
</section>

<section class="px-5 pb-16 pt-8 sm:px-11" data-screen-label="How it works">
  <div class="grid gap-4 md:grid-cols-3">
    <% [["1", "Pick your stone", "We load the tests that work for that stone, plus what the usual imitations look like."],
        ["2", "Do the safe tests first", "Each step says what to do, what real looks like and what fake looks like. Tests that could mark the stone come last and are clearly flagged."],
        ["3", "Get an honest read", "Strong tests count for more than weak ones. You get “consistent with genuine”, “inconclusive” or “signs of an imitation”, never false certainty."]].each do |n, title, body| %>
      <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">Step <%= n %></div>
        <h3 class="mt-2 text-[16px] font-semibold text-ink"><%= title %></h3>
        <p class="mt-2 text-[13.5px] font-light leading-[1.7] text-ui"><%= body %></p>
      </div>
    <% end %>
  </div>
  <p class="mt-6 max-w-[720px] text-[12.5px] font-light leading-[1.7] text-muted">Home tests are guidance, not proof. Only a gemmologist (or a lab report) can confirm what a stone is, and for diamonds, rubies and sapphires no home test can separate lab-grown from natural.</p>
</section>
