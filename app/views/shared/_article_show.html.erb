<%# locals: article, title, breadcrumb_section, breadcrumb_path %>
<% html, headings = content_with_headings(article&.content) %>
<% crumbs = [["Home", root_path]] %>
<% crumbs << [breadcrumb_section, breadcrumb_path] if breadcrumb_section %>
<% crumbs << [title, nil] %>

<div class="grid items-start gap-11 px-5 pb-14 pt-7 sm:px-11 lg:grid-cols-[1fr_300px]">
  <article data-screen-label="Article">
    <%= render "shared/breadcrumb", crumbs: crumbs %>
    <h1 class="mt-4 max-w-[760px] text-[30px] font-semibold leading-[1.15] text-ink sm:text-[38px]"><%= light_ampersand(title) %></h1>
    <div class="mt-4 flex flex-wrap items-center gap-[14px] text-[12px] font-light text-faint">
      <span class="size-[26px] rounded-full bg-[linear-gradient(145deg,#c4b5fd,#8a6fd0)]" aria-hidden="true"></span>
      <span>WriterAlpha Editorial</span>
      <% if article.respond_to?(:published_at) && article&.published_at %><span>·</span><span>Updated <%= (article.try(:updated_at) || article.published_at).strftime("%b %Y") %></span><% end %>
      <% if article&.content.present? %><span>·</span><span><%= reading_time(article.content) %> min read</span><% end %>
    </div>

    <% if article %>
      <% if article.respond_to?(:featured_image_url) && article.featured_image_url.present? %>
        <div class="relative mt-[26px] h-[220px] overflow-hidden rounded-[22px] shadow-article-hero sm:h-[300px]">
          <img src="<%= image_url_for(article.featured_image_url) %>" alt="<%= title %>" class="absolute inset-0 h-full w-full object-cover">
        </div>
      <% end %>
      <div class="article mt-8"><%= render_content(html) %></div>
    <% else %>
      <div class="mt-8 max-w-[680px] rounded-[18px] border border-violet/16 bg-violet/6 px-[26px] py-[22px]">
        <div class="mb-[10px] font-mono text-[10px] uppercase tracking-[0.18em] text-violet">✦ Coming soon</div>
        <p class="text-[14.5px] leading-[1.7] text-callout-text">This guide is being written. Explore the gemstone directory in the meantime.</p>
      </div>
    <% end %>
  </article>

  <aside class="flex flex-col gap-[18px] lg:sticky lg:top-4" data-screen-label="Sidebar">
    <% if headings.any? %>
      <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5">
        <div class="mb-[14px] font-mono text-[10px] uppercase tracking-[0.18em] text-faint">On this page</div>
        <nav class="flex flex-col gap-[11px]" aria-label="On this page">
          <% headings.each do |h| %>
            <a href="#<%= h[:id] %>" class="text-[12.5px] leading-[1.4] text-ui hover:text-violet-deep"><%= h[:title] %></a>
          <% end %>
        </nav>
      </div>
    <% end %>

    <div class="relative overflow-hidden rounded-[18px] bg-ink/97 px-[22px] py-5">
      <div class="absolute -right-[30px] -top-10 h-[140px] w-[180px] blur-[16px] pointer-events-none" style="background:radial-gradient(ellipse,rgba(124,58,237,0.55),transparent 70%)" aria-hidden="true"></div>
      <div class="relative mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Explore stones</div>
      <div class="relative flex flex-col gap-[10px]">
        <a href="<%= gemstones_path(anchor: "filter-color") %>" class="flex items-baseline gap-[9px] text-[12.5px] leading-[1.4] text-white/85 hover:text-white"><span class="text-[11px]">◐</span>By color</a>
        <a href="<%= gemstones_path(anchor: "filter-healing") %>" class="flex items-baseline gap-[9px] text-[12.5px] leading-[1.4] text-white/85 hover:text-white"><span class="text-[11px]">✦</span>By healing power</a>
        <a href="<%= gemstones_by_birth_month_path(value: Date.current.strftime("%B").downcase) %>" class="flex items-baseline gap-[9px] text-[12.5px] leading-[1.4] text-white/85 hover:text-white"><span class="text-[11px]">☾</span>By birth month</a>
        <a href="<%= gemstones_path(anchor: "filter-zodiac") %>" class="flex items-baseline gap-[9px] text-[12.5px] leading-[1.4] text-white/85 hover:text-white"><span class="text-[11px]"><%= text_glyph("♒") %></span>By zodiac</a>
      </div>
      <a href="<%= gemstones_path %>" class="relative mt-4 block text-[12px] font-medium text-lavender hover:text-white">All gemstones →</a>
    </div>
  </aside>
</div>
