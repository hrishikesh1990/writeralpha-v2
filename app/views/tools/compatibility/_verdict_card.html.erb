<%# locals: (result:, compact: false) %>

<% r = result %>
<% colors = compat_colors(r.verdict) %>
<% ctx = r.context && CrystalCompatibility::CONTEXTS[r.context] %>
<% warns = r.practical.count { |p| p.tone == :warn } %>
<%= compat_ring_css %>
<section class="relative overflow-hidden rounded-[24px] bg-ink/97 text-white shadow-hero <%= compact ? 'p-5 sm:p-6' : 'p-6 sm:p-9' %>" aria-label="Verdict for <%= r.a.name %> and <%= r.b.name %>">
  <div class="glow-violet -right-20 -top-24 h-[280px] w-[420px] opacity-60 blur-[40px]" aria-hidden="true"></div>
  <div class="relative">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-lavender">Compatibility verdict<% if ctx %> · <%= ctx[:label] %><% end %></div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-3">
      <a href="<%= r.a.path %>" class="flex items-center gap-[10px] rounded-full py-1 pr-3 text-white hover:text-lavender">
        <%= compat_avatar(r.a, size: compact ? 40 : 52) %><span class="text-[14px] font-medium sm:text-[15px]"><%= r.a.name %></span>
      </a>
      <span class="text-[18px] font-light text-lavender" aria-hidden="true">+</span>
      <a href="<%= r.b.path %>" class="flex items-center gap-[10px] rounded-full py-1 pr-3 text-white hover:text-lavender">
        <%= compat_avatar(r.b, size: compact ? 40 : 52) %><span class="text-[14px] font-medium sm:text-[15px]"><%= r.b.name %></span>
      </a>
    </div>

    <div class="mt-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
      <%= compat_ring(r.score, r.verdict, size: compact ? 96 : 140) %>
      <div class="min-w-0 flex-1">
        <span class="inline-flex items-center rounded-full px-[12px] py-[6px] text-[12px] font-medium leading-none ring-1 ring-inset <%= colors[:pill] %>"><%= r.label %></span>
        <h2 class="mt-3 font-semibold leading-[1.2] text-white <%= compact ? 'text-[19px]' : 'text-[22px] sm:text-[27px]' %>"><%= r.headline %></h2>
        <p class="mt-3 font-light text-white/80 <%= compact ? 'text-[13px] leading-[1.7]' : 'text-[14px] leading-[1.8]' %>"><%= r.summary %></p>
      </div>
    </div>

    <% unless compact %>
      <%= compat_bands(r.score, r.verdict) %>

      <dl class="mt-7 grid gap-3 sm:grid-cols-3">
        <% pair_text, pair_tone = compat_pairing_status(r) %>
        <% vedic_text, vedic_tone = compat_vedic_line(r) %>
        <div class="rounded-[14px] bg-white/[0.06] px-4 py-3">
          <dt class="font-mono text-[9px] uppercase tracking-[0.16em] text-white/50">Tradition</dt>
          <dd class="mt-2"><%= compat_chip(pair_text, pair_tone) %></dd>
        </div>
        <div class="rounded-[14px] bg-white/[0.06] px-4 py-3">
          <dt class="font-mono text-[9px] uppercase tracking-[0.16em] text-white/50">Vedic rule</dt>
          <dd class="mt-2"><%= compat_chip(vedic_text, vedic_tone) %></dd>
        </div>
        <div class="rounded-[14px] bg-white/[0.06] px-4 py-3">
          <dt class="font-mono text-[9px] uppercase tracking-[0.16em] text-white/50">Practical care (not scored)</dt>
          <dd class="mt-2"><%= compat_chip(warns.positive? ? "#{pluralize(warns, 'thing')} to watch" : "Nothing special", warns.positive? ? :warn : :good) %></dd>
        </div>
      </dl>
    <% end %>
  </div>
</section>
