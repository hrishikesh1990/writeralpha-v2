<%# locals: article %>
<% entries = AtlasEntry.all %>
<% if entries.size >= 2 %>
  <section class="mt-10 max-w-[760px] rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft" aria-labelledby="picker-embed-title" data-screen-label="Cleanse planner">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Crystal Safety Checker</div>
    <h2 id="picker-embed-title" class="mt-2 text-[18px] font-semibold leading-[1.3] text-ink">Keep several stones together? Find a cleanse that is safe for all of them</h2>
    <%= render "tools/safety/planner_form", entries: entries, selected: [], frame_attrs: {}, compact: true, uid: "embed" %>
    <p class="mt-3 text-[12.5px] font-light"><a href="<%= tools_safety_path %>" class="font-medium">Or check a single stone, water, salt and sun for all of them →</a></p>
  </section>
<% end %>
