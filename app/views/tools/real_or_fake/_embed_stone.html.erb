<%# Embed on /gemstones/<slug>/how-to-identify. locals: gemstone:, entry: (AtlasEntry or nil), guide: %>
<% entry = local_assigns[:entry] %>
<% check = (AuthenticityCheck.new(entry) if entry && entry.respond_to?(:tests) && entry.tests.any?) %>
<% if check && check.tests.any? %>
  <% tests = check.tests.first(5) %>
  <section class="my-10 rounded-[22px] border border-violet/10 bg-white/85 p-5 shadow-card sm:p-6" aria-labelledby="rof-embed-h" data-screen-label="Real or fake check">
    <div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-violet">Interactive · real or fake?</div>
    <h2 id="rof-embed-h" class="mt-1.5 text-[20px] font-semibold leading-tight text-ink">Check your <%= entry.name %> in a minute</h2>
    <p class="mt-1.5 text-[13.5px] font-light leading-[1.65] text-muted">Answer what you can for the <%= tests.size %> most useful tests. We will tell you what the evidence suggests.</p>

    <%= form_with url: tools_real_or_fake_path, method: :get, class: "mt-4",
                  data: { turbo_frame: "rof-embed-result", controller: "real-or-fake-checklist",
                          real_or_fake_checklist_advance_value: false,
                          action: "change->real-or-fake-checklist#answered" } do %>
      <%= hidden_field_tag :stone, entry.slug, id: nil %>
      <ol class="grid gap-3.5">
        <% tests.each_with_index do |test, i| %>
          <li class="rounded-[16px] border border-violet/10 bg-white px-4 py-3.5">
            <fieldset data-step>
              <legend class="sr-only"><%= test.title %></legend>
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span class="font-mono text-[11.5px] text-muted"><%= i + 1 %></span>
                <span class="text-[14.5px] font-semibold text-ink"><%= test.title %></span>
                <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-muted"><%= test.weight_label %></span>
                <% if test.destructive? %><%= verdict_badge(nil, label: "May mark the stone", tone: :warn) %><% end %>
              </div>
              <% if test.how.present? %><p class="mt-1.5 text-[13px] font-light leading-[1.65] text-ui"><%= test.how %></p><% end %>
              <div class="mt-2.5 grid gap-1.5 text-[12.5px] font-light leading-[1.55] text-ui sm:grid-cols-2">
                <% if test.real.present? %><p><span class="font-medium text-emerald-800">Real: </span><%= test.real %></p><% end %>
                <% if test.fake.present? %><p><span class="font-medium text-amber-800">Fake: </span><%= test.fake %></p><% end %>
              </div>
              <div class="mt-3 grid grid-cols-3 gap-2" role="radiogroup" aria-label="What did you see for <%= test.title.downcase %>?">
                <% RealOrFakeHelper::ROF_CHOICES.each do |value, label| %>
                  <label class="relative block">
                    <input type="radio" name="a[<%= test.id %>]" value="<%= value %>" class="<%= RealOrFakeHelper::ROF_INPUT %>">
                    <span class="<%= rof_choice_pill(value) %>"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          </li>
        <% end %>
      </ol>
      <div class="mt-4" data-real-or-fake-checklist-target="submit">
        <button type="submit" class="min-h-[48px] rounded-full bg-ink px-6 text-[13.5px] font-medium text-white card-transition hover:bg-violet-deep">See what my answers suggest</button>
      </div>
    <% end %>

    <%= turbo_frame_tag "rof-embed-result", target: "_top", class: "mt-4 block empty:mt-0", aria: { live: "polite" } do %><% end %>

    <p class="mt-4 text-[12.5px] font-light leading-[1.65] text-muted">
      Home tests are guidance, not proof. Only a gemmologist (or a lab report) can confirm what a stone is.
      <a href="<%= rof_path(entry) %>" class="font-medium">Open the full <%= entry.name %> checklist →</a>
    </p>
  </section>
<% end %>
