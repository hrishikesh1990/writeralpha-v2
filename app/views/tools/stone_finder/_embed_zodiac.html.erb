<%# locals: filter_type, value %>
<%
  sign = Atlas::ZODIAC.include?(local_assigns[:value].to_s) ? value.to_s : nil
  data = sign && StoneFinder.for_sign(AtlasEntry.all, sign)
%>
<% if data && (data[:picks].any? || data[:avoid].any?) %>
  <%
    vocab = StoneFinder::Vocab
    sign_name = vocab.sign_name(sign)
    eyebrow = "font-mono text-[10px] uppercase tracking-[0.18em] text-faint"
    short = ->(pick) { pick.reasons.reject { |r| r.kind == :easy || r.kind == :about }.first(2).map(&:text).presence || [pick.reasons.first&.text].compact }
  %>
  <section class="mx-5 mb-2 mt-2 max-w-[820px] rounded-[20px] border border-violet/10 bg-white/85 px-5 py-6 shadow-card sm:mx-11 sm:px-7" aria-labelledby="zodiac-embed-<%= sign %>" data-screen-label="Stone Finder for <%= sign_name %>">
    <div class="<%= eyebrow %> !text-violet">✦ Stone Finder</div>
    <h2 id="zodiac-embed-<%= sign %>" class="mt-2 text-[22px] font-semibold leading-[1.25] text-ink">Best stones for <%= sign_name %>, ranked</h2>
    <p class="mt-2 text-[13.5px] font-light leading-[1.7] text-ui"><%= vocab.sign_glyph(sign) %>&#xFE0E; <%= sign_name %> (<%= Atlas::Astro::SIGN_DATES[sign] %>) is a <%= Atlas::Astro::SIGN_ELEMENT[sign] %> sign. Ranked by astrological tradition and how easy each stone is to live with.</p>

    <% if data[:picks].any? %>
      <ol class="mt-5 flex flex-col gap-[10px]">
        <% data[:picks].each_with_index do |pick, i| %>
          <li class="flex items-start gap-3 rounded-[14px] border border-violet/10 bg-white px-4 py-3">
            <span class="mt-[2px] w-[22px] flex-none font-mono text-[11px] text-faint"><%= i + 1 %></span>
            <div class="min-w-0 flex-1">
              <a href="<%= pick.entry.path %>" class="text-[14px] font-semibold text-ink hover:text-violet-deep"><%= pick.entry.name %></a>
              <p class="mt-[3px] text-[12.5px] font-light leading-[1.65] text-ui"><%= short.(pick).join(". ") %>.</p>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if data[:avoid].any? %>
      <h3 class="mt-7 text-[16px] font-semibold text-ink">Stones <%= sign_name %> is traditionally told to avoid</h3>
      <ul class="mt-3 flex flex-col gap-[10px]">
        <% data[:avoid].each do |e, why| %>
          <li class="rounded-[14px] border border-amber-600/20 bg-amber-500/8 px-4 py-3 text-[13px] font-light leading-[1.7] text-ui">
            <a href="<%= e.path %>" class="font-semibold text-ink hover:text-violet-deep"><%= e.name %></a>
            <% if e.guide?("who-should-not-wear") %><span class="text-faint"> · </span><a href="<%= e.guide_path('who-should-not-wear') %>" class="text-[12px] font-medium">Who should not wear it</a><% end %>
            <br><%= why %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="mt-6 flex flex-col gap-3 rounded-[16px] bg-violet/6 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[13px] font-light leading-[1.6] text-callout-text">Add what you want help with, how you will use the stone and your budget for a personal ranking.</p>
      <a href="<%= tools_stone_finder_path(sign: sign) %>" class="flex-none rounded-full bg-violet px-[18px] py-[10px] text-center text-[12.5px] font-medium !text-white card-transition hover:bg-violet-deep">Personalise for <%= sign_name %> →</a>
    </div>
    <%= tradition_note "Zodiac, element and planet associations come from astrological tradition, and Vedic advice is normally read from a full birth chart. They are not scientific claims." %>
  </section>
<% end %>
