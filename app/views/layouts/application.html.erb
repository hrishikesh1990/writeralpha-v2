<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= @meta&.dig(:title) || "WriterAlpha — Gemstone & Crystal Guide" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= @meta&.dig(:description) || "Expert guides to gemstones, crystal healing, zodiac stones, and birthstones." %>">
  <meta charset="utf-8">
  <link rel="canonical" href="<%= request.original_url.split('?').first %>">
  <meta property="og:title" content="<%= @meta&.dig(:title) || "WriterAlpha" %>">
  <meta property="og:description" content="<%= @meta&.dig(:description) %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta name="theme-color" content="#fbfaff">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen text-ui">
  <div class="mx-auto flex min-h-screen flex-col <%= content_for?(:container_class) ? yield(:container_class) : "max-w-[1200px]" %>">

    <!-- Nav -->
    <header class="flex items-center justify-between gap-4 px-5 py-5 sm:px-11" data-screen-label="Nav">
      <a href="<%= root_path %>" class="flex shrink-0 items-center gap-[9px] text-[18px] font-semibold text-logo hover:text-logo">
        <span class="logo-orb" aria-hidden="true"></span>writeralpha
      </a>
      <nav class="flex min-w-0 items-center gap-1 overflow-x-auto text-[13.5px] text-ui [scrollbar-width:none]" aria-label="Primary">
        <%= link_to "Gemstones", gemstones_path, class: nav_link_class(nav_active?(:gemstones)) %>
        <%= link_to "Crystals for", gemstones_by_healing_path(value: "protection"), class: nav_link_class(nav_active?(:crystals)) %>
        <%= link_to "Angel numbers", angel_numbers_path, class: nav_link_class(nav_active?(:angel_numbers)) %>
        <%= link_to "Learn", blog_path(category: "learn"), class: nav_link_class(nav_active?(:learn)) %>
        <%= link_to "Blog", blog_path, class: nav_link_class(nav_active?(:blog)) %>
        <% if content_for?(:nav_cta) %>
          <a href="<%= gemstones_path %>" class="ml-[10px] hidden shrink-0 whitespace-nowrap rounded-full bg-ink px-5 py-[9px] text-[12.5px] font-medium text-white hover:bg-ink hover:text-white sm:inline-block">Find your stone</a>
        <% end %>
      </nav>
    </header>

    <!-- Flash -->
    <% if notice %>
      <div class="px-5 pt-2 sm:px-11">
        <div class="rounded-[14px] border border-violet/16 bg-violet/6 px-4 py-3 text-[13px] text-callout-text"><%= notice %></div>
      </div>
    <% end %>

    <!-- Main -->
    <main class="flex-1"><%= yield %></main>

    <!-- Footer -->
    <footer class="mt-auto flex flex-col gap-3 border-t border-ui/12 px-5 pb-10 pt-7 sm:flex-row sm:items-center sm:justify-between sm:px-11" data-screen-label="Footer">
      <div class="text-[12px] font-light text-faint">© <%= Date.current.year %> WriterAlpha — the atlas of stones</div>
      <div class="flex gap-[22px] text-[12px] text-ui">
        <a href="/about" class="text-ui hover:text-violet-deep">About</a>
        <a href="/contact" class="text-ui hover:text-violet-deep">Contact</a>
        <a href="/write-for-us" class="text-ui hover:text-violet-deep">Write for us</a>
      </div>
    </footer>
  </div>
</body>
</html>
