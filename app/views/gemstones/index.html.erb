<% content_for :container_class, "max-w-[1280px]" %>
<%
  active = @active || {}
  has_active = active.any?
  sidebar_keys = %i[color healing transparency zodiac letter]
  crumbs = [["Home", root_path], ["Gemstones", has_active && @filter_name ? gemstones_path : nil]]
  crumbs << [@filter_name, nil] if @filter_name
  panel_class = "rounded-[18px] border border-violet/10 bg-white/80 px-5 py-[18px]"
  eyebrow_class = "mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-faint"
%>

<section class="px-5 pb-6 pt-9 sm:px-11" data-screen-label="Directory header">
  <%= render "shared/breadcrumb", crumbs: crumbs %>
  <h1 class="mt-3 text-[30px] font-light text-ink sm:text-[36px]"><%= @heading %> <span class="text-gradient font-semibold">— <%= @gemstones.size %> of <%= @total_count %> stones</span></h1>
  <p class="mt-2 text-[14px] font-light text-muted">
    <% if active[:q].present? %>Showing stones matching “<%= active[:q] %>”. <% end %>Filter by color, healing power, transparency, zodiac, birth month, or letter.
  </p>
</section>

<div class="grid items-start gap-8 px-5 pb-14 pt-2 sm:px-11 lg:grid-cols-[260px_1fr]">
  <!-- Filters -->
  <aside class="flex flex-col gap-[22px] lg:sticky lg:top-4" data-screen-label="Filters">
    <% if has_active %>
      <a href="<%= gemstones_path %>" class="rounded-full bg-violet/8 px-4 py-[10px] text-center text-[12px] font-medium text-violet-deep hover:bg-violet/12">Clear all filters ✕</a>
    <% end %>

    <div id="filter-color" class="<%= panel_class %> scroll-mt-4">
      <div class="<%= eyebrow_class %>">Color</div>
      <div class="flex flex-wrap gap-2">
        <% @colors.each do |color| %>
          <% selected = active[:color] == color.slug %>
          <a href="<%= toggle_filter_path(active, :color, color.slug) %>" title="<%= color.name %>" aria-label="<%= color.name %>" aria-pressed="<%= selected %>"
             class="box-border block size-[26px] rounded-full border-2 card-transition <%= selected ? "border-violet-deep" : "border-ui/18 hover:border-violet/50" %>"
             style="background:<%= color_swatch(color) %>"></a>
        <% end %>
      </div>
    </div>

    <div id="filter-healing" class="<%= panel_class %> scroll-mt-4">
      <div class="<%= eyebrow_class %>">Healing power</div>
      <div class="flex flex-wrap gap-[6px]">
        <% @healing_powers.each do |power| %>
          <a href="<%= toggle_filter_path(active, :healing, power.slug) %>" class="<%= filter_pill_class(active[:healing] == power.slug) %>"><%= power.name %></a>
        <% end %>
      </div>
    </div>

    <div id="filter-transparency" class="<%= panel_class %> scroll-mt-4">
      <div class="<%= eyebrow_class %>">Transparency</div>
      <div class="flex flex-wrap gap-[6px]">
        <% @transparencies.each do |t| %>
          <a href="<%= toggle_filter_path(active, :transparency, t.slug) %>" class="<%= filter_pill_class(active[:transparency] == t.slug) %>"><%= t.name %></a>
        <% end %>
      </div>
    </div>

    <div id="filter-zodiac" class="<%= panel_class %> scroll-mt-4">
      <div class="<%= eyebrow_class %>">Zodiac</div>
      <div class="grid grid-cols-4 gap-[6px]">
        <% @zodiac_signs.each do |sign| %>
          <% selected = active[:zodiac] == sign.slug %>
          <a href="<%= toggle_filter_path(active, :zodiac, sign.slug) %>" title="<%= sign.name %>" aria-label="<%= sign.name %>"
             class="flex items-center justify-center rounded-[10px] border py-2 text-[15px] leading-none card-transition <%= selected ? "border-violet/90 bg-violet/90 text-white hover:text-white" : "border-ui/14 bg-pill-off/90 text-ui hover:border-violet/35 hover:text-violet-deep" %>"><%= text_glyph(sign.symbol) %></a>
        <% end %>
      </div>
    </div>

    <div id="filter-letter" class="<%= panel_class %> scroll-mt-4">
      <div class="<%= eyebrow_class %>">A – Z</div>
      <div class="flex flex-wrap gap-1">
        <% @letters.each do |letter| %>
          <% selected = active[:letter] == letter %>
          <a href="<%= toggle_filter_path(active, :letter, letter) %>" class="flex size-[26px] items-center justify-center rounded-[8px] font-mono text-[11px] card-transition <%= selected ? "bg-violet/90 text-white hover:text-white" : "text-ui hover:bg-violet/8 hover:text-violet-deep" %>"><%= letter %></a>
        <% end %>
      </div>
    </div>
  </aside>

  <!-- Results -->
  <div>
    <% if @gemstones.any? %>
      <div class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-3" data-screen-label="Results grid">
        <% @gemstones.each do |gemstone| %>
          <%= render "gemstones/stone_card", gemstone: gemstone, variant: :directory %>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 text-center font-light text-muted">No stones match this combination. <a href="<%= gemstones_path %>" class="font-medium text-violet-deep">Clear filters</a></div>
    <% end %>
  </div>
</div>
