<% gemstone = @gemstone %>
<% primary_color = gemstone.colors.first %>
<% facts = gemstone_facts(gemstone) %>

<!-- Hub hero -->
<section class="px-5 pb-2 pt-7 sm:px-11" data-screen-label="Hub hero">
  <%= render "shared/breadcrumb", crumbs: [["Home", root_path], ["Gemstones", gemstones_path], [gemstone.name, nil]] %>
  <div class="mt-6 grid items-start gap-10 lg:grid-cols-[420px_1fr]">
    <div class="relative">
      <div class="absolute -inset-6 blur-[28px] pointer-events-none" style="background:radial-gradient(ellipse,rgba(139,92,246,0.28),transparent 70%)" aria-hidden="true"></div>
      <div class="relative flex h-[380px] items-end justify-end overflow-hidden rounded-[26px] p-[14px] shadow-hero" style="background:<%= stone_gradient(gemstone) %>">
        <% if gemstone.featured_image_url.present? %>
          <img src="<%= image_url_for(gemstone.featured_image_url) %>" alt="<%= gemstone.name %>" class="absolute inset-0 h-full w-full object-cover">
        <% else %>
          <span class="relative font-mono text-[10px] uppercase tracking-[0.1em] text-white/85"><%= gemstone.name %> photo</span>
        <% end %>
      </div>
    </div>
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-[36px] font-semibold leading-none text-ink sm:text-[44px]"><%= gemstone.name %></h1>
        <% if primary_color %>
          <a href="<%= gemstones_by_color_path(color: primary_color.slug) %>" class="rounded-full px-[13px] py-[5px] text-[11px] font-medium leading-none" style="<%= color_chip_style(primary_color) %>"><%= primary_color.name %></a>
        <% end %>
      </div>
      <% if gemstone.subtitle.present? %>
        <p class="mt-1 text-[16px] font-medium text-violet"><%= gemstone.subtitle %></p>
      <% end %>
      <% if gemstone.description.present? %>
        <p class="mt-4 max-w-[560px] text-[14.5px] font-light leading-[1.75] text-ui"><%= plain_excerpt(gemstone.description) %></p>
      <% end %>
      <% if gemstone.healing_powers.any? %>
        <div class="mt-[18px] flex flex-wrap gap-[6px]">
          <% gemstone.healing_powers.each do |power| %>
            <a href="<%= gemstones_by_healing_path(value: power.slug) %>" class="rounded-full bg-violet/8 px-[14px] py-[6px] text-[11px] leading-none text-violet-deep card-transition hover:bg-violet/14"><%= power.name %></a>
          <% end %>
        </div>
      <% end %>
      <dl class="mt-[26px] grid max-w-[620px] grid-cols-2 gap-[10px] sm:grid-cols-4">
        <% facts.each do |label, value| %>
          <div class="rounded-[14px] border border-violet/10 bg-white/80 px-[14px] py-3">
            <dt class="font-mono text-[8.5px] uppercase tracking-[0.16em] text-faint"><%= label %></dt>
            <dd class="mt-[5px] text-[13px] font-medium text-ink"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</section>

<!-- Guides -->
<section class="px-5 pb-4 pt-11 sm:px-11" data-screen-label="Guides">
  <h2 class="mb-[6px] text-[21px] font-semibold text-ink"><%= gemstone.name %> guides</h2>
  <p class="mb-5 text-[13px] font-light text-muted">Nine complete guides to living with this stone.</p>
  <div class="grid grid-cols-1 gap-[14px] sm:grid-cols-2 lg:grid-cols-3">
    <% gemstone.hub_sub_pages.each do |guide| %>
      <a href="/gemstones/<%= gemstone.slug %>/<%= guide[:path] %>" class="flex items-center gap-[14px] rounded-[16px] border border-violet/10 bg-white/80 px-[18px] py-4 card-transition hover:border-violet/35 hover:shadow-guide-hover">
        <span class="flex size-[38px] flex-none items-center justify-center rounded-[12px] bg-violet/8 text-[16px]"><%= guide[:icon] %></span>
        <span class="text-[13px] font-medium leading-[1.4] text-ink"><%= guide[:short] %></span>
        <span class="ml-auto text-arrow" aria-hidden="true">→</span>
      </a>
    <% end %>
  </div>
</section>

<!-- Similar stones -->
<% if @similar_gemstones.any? %>
<section class="px-5 pb-12 pt-10 sm:px-11" data-screen-label="Related stones">
  <div class="mb-[18px] flex items-baseline justify-between">
    <h2 class="text-[21px] font-semibold text-ink">Similar stones</h2>
    <% if primary_color %>
      <a href="<%= gemstones_by_color_path(color: primary_color.slug) %>" class="text-[12.5px] font-medium">All <%= primary_color.name.downcase %> stones →</a>
    <% else %>
      <a href="<%= gemstones_path %>" class="text-[12.5px] font-medium">All stones →</a>
    <% end %>
  </div>
  <div class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-4">
    <% @similar_gemstones.each do |similar| %>
      <%= render "gemstones/stone_card", gemstone: similar, variant: :compact %>
    <% end %>
  </div>
</section>
<% end %>
