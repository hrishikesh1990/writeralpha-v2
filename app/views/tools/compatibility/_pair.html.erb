<%# locals: (result:, article: nil, context: nil) %>
<% r = result %>
<div class="flex flex-col gap-5">
  <%= render "tools/compatibility/verdict_card", result: r %>

  <% order = r.avoid? ? %i[minus plus] : %i[plus minus] %>
  <% groups = { plus: ["Why they work", r.plus, "Crystal tradition and Vedic astrology, labelled as such."],
                minus: ["Watch out", r.minus, nil] } %>
  <% shown = order.map { |k| groups[k] }.select { |_, list, _| list.any? } %>
  <% if shown.any? || r.neutral.any? %>
    <div class="grid items-start gap-5 <%= 'lg:grid-cols-2' if shown.size > 1 %>">
      <% shown.each do |title, list, hint| %>
        <%= render "tools/compatibility/reason_group", title: title, reasons: list, hint: hint %>
      <% end %>
    </div>
    <%= render "tools/compatibility/reason_group", title: "Good to know", reasons: r.neutral %>
  <% end %>

  <%= render "tools/compatibility/practical", result: r %>

  <%= tradition_note "Chakras, elements, energy and planetary friendships come from crystal-healing and Vedic astrological tradition, and traditions disagree with each other. They are not scientific claims, and no stone replaces medical care. The practical care notes are the part you can verify." %>

  <nav class="flex flex-wrap items-center gap-x-5 gap-y-3 rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-4 text-[13px]" aria-label="Related pages">
    <% [r.a, r.b].each do |e| %>
      <a href="<%= e.path %>" class="font-medium"><%= e.name %> guide →</a>
    <% end %>
    <% [r.a, r.b].each do |e| %>
      <% if e.guide?("combinations") %><a href="<%= e.guide_path('combinations') %>" class="font-medium"><%= e.name %> combinations →</a><% end %>
    <% end %>
    <% if article %><a href="<%= article.canonical_path %>" class="font-medium">Read: <%= article.title %> →</a><% end %>
    <button type="button" class="ml-auto rounded-full bg-violet/8 px-4 py-[8px] text-[12px] font-medium text-violet-deep card-transition hover:bg-violet/14"
            data-controller="compatibility-copy" data-action="compatibility-copy#copy" data-compatibility-copy-url-value="<%= compat_pair_path(r.a, r.b, r.context) %>">
      <span data-compatibility-copy-target="label">Copy link to this verdict</span>
    </button>
  </nav>

  <p class="text-[13px] font-light text-ui">
    Want other options? See <%= link_to "best partners for #{r.a.name}", tools_compatibility_path(a: r.a.slug, ctx: r.context.presence) %>
    or <%= link_to "best partners for #{r.b.name}", tools_compatibility_path(a: r.b.slug, ctx: r.context.presence) %>.
  </p>
</div>
