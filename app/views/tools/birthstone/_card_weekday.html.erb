<%# locals: wd (Weekday), lang, t %>
<% rn = wd.ratna %>
<% big = lang == "en" ? rn.name : (rn.pair(lang)&.last || rn.name) %>
<article class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 lg:col-span-2" aria-labelledby="bs-day-h" data-screen-label="Weekday card">
  <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Weekday tradition</div>
  <div class="mt-2 flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <div>
      <h2 id="bs-day-h" class="text-[21px] font-semibold text-ink"><%= t.(:your_weekday) %></h2>
      <p class="mt-1 text-[13px] font-light text-muted"><%= t.(:born_on, day: BirthstoneCalculator.weekday_name(wd.wday, lang)) %></p>
    </div>
    <div class="flex items-center gap-4 rounded-[14px] bg-violet/5 px-4 py-3">
      <div>
        <div class="text-[11px] font-light text-muted"><%= t.(:weekday_planet) %>: <%= lang == "en" ? rn.graha_en : tag.span(rn.graha_pair(lang).last || rn.graha_en, lang: lang) %></div>
        <div class="text-[17px] font-semibold leading-[1.35] text-ink"><%= lang == "en" ? big : tag.span(big, lang: lang) %><% if lang != "en" %> <span class="text-[12px] font-light text-faint"><%= rn.name %></span><% end %></div>
        <div class="mt-[2px] text-[11.5px] font-light text-muted"><%= render "tools/birthstone/pair_both", hi: rn.hi, bn: rn.bn %></div>
      </div>
      <% if rn.live? %><a href="<%= rn.path %>" class="text-[12px] font-medium"><%= rn.entry.name %> guide →</a><% end %>
    </div>
  </div>
  <p class="mt-4 max-w-[760px] text-[12.5px] font-light leading-[1.7] text-ui"><%= t.(:weekday_note) %></p>
</article>
