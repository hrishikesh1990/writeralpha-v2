<%# locals: entries, stone, plan_slugs, framed, counts %>
<% frame_attrs = framed ? { turbo_frame: "safety_result", turbo_action: "advance" } : {} %>
<div class="grid gap-[14px] md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">One stone</div>
    <h2 class="mt-2 text-[17px] font-semibold text-ink">Check a single crystal</h2>
    <%= form_with url: tools_safety_path, method: :get, class: "mt-4 flex flex-col gap-3 sm:flex-row sm:items-end md:flex-col lg:flex-row",
                  data: frame_attrs.merge(controller: "safety-autosubmit", action: "change->safety-autosubmit#submit") do %>
      <div class="min-w-0 flex-1">
        <label for="safety-stone-select" class="block text-[12px] font-medium text-ink">Stone</label>
        <select id="safety-stone-select" name="stone" class="mt-1 block w-full rounded-[12px] border border-violet/20 bg-white px-3 py-[10px] text-[13.5px] text-ink focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/25">
          <option value="">Choose a stone…</option>
          <% entries.each do |e| %>
            <option value="<%= e.slug %>" <%= "selected" if stone && stone.slug == e.slug %>><%= e.name %></option>
          <% end %>
        </select>
      </div>
      <button type="submit" data-safety-autosubmit-target="button" class="rounded-full bg-ink px-5 py-[10px] text-[12.5px] font-medium text-white hover:bg-violet-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet">Check safety</button>
    <% end %>
    <p class="mt-3 text-[12px] font-light leading-[1.6] text-muted">Or tap any stone name in the full list below.</p>
    <div class="mt-5 border-t border-violet/10 pt-4">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Quick answers</div>
      <ul class="mt-3 flex flex-col gap-[6px] text-[13px]">
        <% [["Which crystals can go in water?", "water"], ["Which crystals can't be soaked?", "dry"], ["Which crystals are salt safe?", "salt"], ["Which crystals are sun safe?", "sun"], ["Which crystals are non-toxic?", "nontoxic"]].each do |label, key| %>
          <li><a href="<%= tools_safety_path(f: [key], anchor: "matrix") %>" data-turbo-frame="_top" class="inline-flex items-baseline gap-2 text-ui hover:text-violet-deep"><%= label %> <span class="font-mono text-[10px] text-faint"><%= counts[key] %></span></a></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="rounded-[18px] border border-violet/10 bg-white/80 px-[22px] py-5 shadow-card-soft">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Several stones</div>
    <h2 class="mt-2 text-[17px] font-semibold text-ink">Cleanse them together</h2>
    <%= render "tools/safety/planner_form", entries: entries, selected: plan_slugs, frame_attrs: frame_attrs, compact: false, uid: "page" %>
  </div>
</div>
